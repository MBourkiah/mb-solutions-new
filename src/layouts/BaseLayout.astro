---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'MB-Solutions – Webdesign, IT-Services und Branding für KMU und Handwerksbetriebe in Köln.',
  ogImage = 'https://www.mb-solutions.biz/logos/mb-icon-512-eckig.png',
} = Astro.props;

const canonical = `https://www.mb-solutions.biz${Astro.url.pathname}`;
const fullTitle = `${title} | MB-Solutions`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MB-Solutions" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons & App-Icons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/mb-icon-32-favicon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/mb-icon-16-favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/mb-icon-180-appicon.png" />

    <!-- Page-specific head content (schema, preloads, etc.) -->
    <slot name="head" />
  </head>
  <body>
    <!-- Skip link -->
    <a
      href="#main-content"
      style="position:absolute;left:-9999px;top:4px;z-index:10000;background:var(--accent);color:#fff;padding:8px 16px;border-radius:var(--r-md);font-size:14px;font-weight:600;text-decoration:none;"
      onfocus="this.style.left='4px'"
      onblur="this.style.left='-9999px'"
    >Zum Hauptinhalt springen</a>

    <slot />

    <!-- WhatsApp floating button -->
    <a
      href="https://wa.me/491718165966"
      target="_blank"
      rel="noopener noreferrer"
      id="wa-btn"
      aria-label="Per WhatsApp schreiben"
      title="Per WhatsApp schreiben"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 32 32" fill="white" aria-hidden="true">
        <path d="M16 2C8.268 2 2 8.268 2 16c0 2.492.655 4.835 1.802 6.865L2 30l7.335-1.775A13.94 13.94 0 0 0 16 30c7.732 0 14-6.268 14-14S23.732 2 16 2zm0 25.6a11.54 11.54 0 0 1-5.88-1.607l-.422-.25-4.353 1.052 1.083-4.232-.277-.437A11.537 11.537 0 0 1 4.4 16C4.4 9.593 9.593 4.4 16 4.4S27.6 9.593 27.6 16 22.407 27.6 16 27.6zm6.33-8.63c-.347-.173-2.051-1.012-2.37-1.128-.318-.116-.55-.173-.78.174-.232.347-.897 1.128-1.1 1.36-.202.231-.405.26-.752.087-.347-.174-1.464-.54-2.788-1.72-1.031-.92-1.727-2.056-1.93-2.403-.202-.347-.022-.535.152-.707.156-.156.347-.405.52-.608.174-.202.232-.347.347-.578.116-.232.058-.434-.03-.607-.087-.174-.78-1.882-1.07-2.577-.281-.675-.567-.583-.78-.595l-.665-.012c-.232 0-.607.087-.925.434-.318.347-1.214 1.186-1.214 2.892s1.243 3.354 1.416 3.586c.174.231 2.447 3.735 5.93 5.24.829.358 1.476.572 1.98.731.832.265 1.59.228 2.189.138.667-.099 2.051-.839 2.342-1.65.29-.81.29-1.504.202-1.65-.087-.145-.318-.231-.665-.405z"/>
      </svg>
    </a>

    <style>
      #wa-btn {
        position: fixed; bottom: 22px; right: 22px; z-index: 9000;
        width: 54px; height: 54px;
        display: flex; align-items: center; justify-content: center;
        background: #25D366; border-radius: 50%;
        box-shadow: 0 6px 20px rgba(30,27,46,0.20);
        text-decoration: none;
        transition: transform 200ms var(--ease-out);
      }
      @media (hover: hover) and (pointer: fine) {
        #wa-btn:hover { transform: scale(1.08); }
      }
    </style>

    <script is:inline>
      /*
       * Fallback für Browser ohne scroll-getriebene CSS-Animationen.
       * Wo animation-timeline unterstützt wird, übernimmt reines CSS
       * (siehe global.css) und dieses Script läuft gar nicht.
       */
      (function () {
        var cssDriven = window.CSS && CSS.supports && CSS.supports('animation-timeline: view()');
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (cssDriven && !reduced) return;

        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '-12px 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { obs.observe(el); });
      })();
    </script>
  </body>
</html>
