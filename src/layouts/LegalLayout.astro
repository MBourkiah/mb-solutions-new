---
/**
 * Layout für Rechtstexte (Impressum, Datenschutz).
 * Lange Fließtexte brauchen andere Maße als Marketing-Seiten: engere
 * Textspalte, klare Gliederung, keine Deko.
 */
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  heading: string;
  intro?: string;
  updated: string;
}

const { title, description, heading, intro, updated } = Astro.props;
---

<style>
  .legal { padding: clamp(3.5rem, 8vh, 6rem) 0 clamp(4rem, 8vw, 6rem); }
  .legal-inner { max-width: 46rem; }

  .legal-h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.05;
    margin: 1.25rem 0 0;
  }
  .legal-intro {
    font-size: 1.0625rem; color: var(--ink-2); line-height: 1.75;
    margin: 1.25rem 0 0; max-width: 62ch;
  }
  .legal-updated {
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3);
    margin-top: 1.75rem; padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    display: block;
  }

  /* Inhalt aus dem Slot */
  .legal-body { margin-top: clamp(2.5rem, 5vw, 3.5rem); display: flex; flex-direction: column; gap: clamp(2rem, 4vw, 2.75rem); }

  .legal-body :global(section) { display: flex; flex-direction: column; gap: 0.875rem; }
  .legal-body :global(h2) {
    font-size: 1.25rem; font-weight: 700; letter-spacing: -0.015em;
    line-height: 1.3; margin: 0;
    display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.5rem;
  }
  .legal-body :global(h2 .n) {
    font-family: var(--font-mono); font-size: 13px; font-weight: 500;
    color: var(--accent); padding-top: 3px;
  }
  .legal-body :global(h3) {
    font-size: 1rem; font-weight: 700; letter-spacing: -0.01em;
    margin: 0.5rem 0 0; color: var(--ink);
  }
  .legal-body :global(p) {
    font-size: 0.9688rem; color: var(--ink-2); line-height: 1.8; margin: 0;
    max-width: 68ch;
  }
  .legal-body :global(p strong) { color: var(--ink); font-weight: 600; }
  .legal-body :global(a) {
    color: var(--accent-strong); text-decoration: underline;
    text-decoration-thickness: 1px; text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .legal-body :global(a:hover) { color: var(--accent); }
  .legal-body :global(ul) {
    margin: 0; padding-left: 1.125rem;
    display: flex; flex-direction: column; gap: 0.5rem;
    font-size: 0.9688rem; color: var(--ink-2); line-height: 1.7;
  }
  .legal-body :global(li) { max-width: 66ch; }
  .legal-body :global(li strong) { color: var(--ink); font-weight: 600; }
  .legal-body :global(address) {
    font-style: normal; font-size: 0.9688rem; color: var(--ink-2); line-height: 1.8;
  }

  /* Hervorgehobener Kasten für zentrale Aussagen */
  .legal-body :global(.note) {
    background: var(--surface); border: 1px solid var(--border);
    border-left: 3px solid var(--accent); border-radius: var(--r-md);
    padding: 1.25rem 1.5rem;
    display: flex; flex-direction: column; gap: 0.625rem;
  }
  .legal-body :global(.note p) { max-width: 64ch; }

  /* Definitionsliste für Empfänger/Dienste */
  .legal-body :global(dl) {
    margin: 0; display: grid; grid-template-columns: 10.5rem 1fr;
    gap: 0.5rem 1.25rem;
    font-size: 0.9375rem; line-height: 1.7;
  }
  .legal-body :global(dt) {
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3);
    padding-top: 4px;
  }
  .legal-body :global(dd) { margin: 0; color: var(--ink-2); }

  @media (max-width: 600px) {
    .legal-body :global(h2) { grid-template-columns: 1.875rem 1fr; }
    .legal-body :global(dl) { grid-template-columns: 1fr; gap: 0.125rem 0; }
    .legal-body :global(dd) { margin-bottom: 0.875rem; }
  }
</style>

{/* Absichtlich kein noindex: Impressum und Datenschutz sind Vertrauenssignale,
    die Google lesen soll — und sie stehen in der Sitemap, was sich mit noindex
    widersprechen würde. */}
<BaseLayout title={title} description={description}>
  <Navbar />
  <main id="main-content" class="legal">
    <div class="container-site">
      <div class="legal-inner">
        <p class="label-mono">Rechtliches</p>
        <h1 class="legal-h1">{heading}</h1>
        {intro && <p class="legal-intro">{intro}</p>}
        <span class="legal-updated">Stand: {updated}</span>

        <div class="legal-body">
          <slot />
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
