---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import DecoShapes from '../components/DecoShapes.astro';

const projects = [
  {
    title: 'Diese Website',
    category: 'Webdesign — in eigener Sache',
    isReal: true,
    visual: { real: 'mb-solutions-website', variant: 'web' as const },
    visualAlt: 'Screenshot der Startseite von mb-solutions.biz',
    visualCaption: 'Echter Screenshot · mb-solutions.biz',
    problem: 'MB-Solutions brauchte genau das, was ich Kunden verspreche: einen Auftritt, der Vertrauen aufbaut — ohne fertige Kundenreferenzen und ohne so zu tun, als gäbe es welche.',
    approach: 'Komplettes Redesign mit Astro und Tailwind: eigenes Farbsystem (Tiefviolett & Papier), selbst gehostete Schriften, fast kein JavaScript — und Konzeptarbeiten ehrlich als solche gekennzeichnet.',
    result: 'Die Seite, die du gerade liest: schnell, ohne Bilder von fremden Servern, ehrlich im Inhalt. Derselbe Prozess und dieselben Bausteine, die auch dein Projekt bekommt.',
    transfer: 'Jeden Betrieb, der professionell auftreten will, ohne sich größer darzustellen, als er ist.',
  },
  {
    title: 'Café Morgenrot',
    category: 'Webdesign — Gastronomie',
    isReal: false,
    visual: { real: 'cafe-morgenrot', variant: 'web' as const },
    visualAlt: 'Abstrakte Illustration einer Website-Struktur in Violett auf Papierweiß',
    problem: 'Reservierungen liefen ausschließlich über das Telefon. Wer abends nach Feierabend einen Tisch buchen wollte, landete auf dem Anrufbeantworter — und buchte woanders.',
    approach: 'Mobile-first Website mit Online-Reservierung, Speisekarte als echte Webseite statt PDF-Download, Anbindung an Google Maps und Google-Unternehmensprofil.',
    result: 'Gäste reservieren rund um die Uhr, das Team wird seltener aus dem Service ans Telefon geholt. Die Speisekarte ist bei Google auffindbar.',
    transfer: 'Restaurants, Bäckereien, Bars — überall, wo Termine oder Tische gebucht werden.',
  },
  {
    title: 'Keller & Söhne GmbH',
    category: 'IT-Setup + Branding — Handwerk',
    isReal: false,
    visual: { real: 'keller-soehne', variant: 'it' as const },
    visualAlt: 'Abstrakte Illustration: verstreute Elemente laufen in eine geordnete Struktur zusammen',
    problem: 'Angebote gingen von drei verschiedenen Freemail-Adressen raus, jedes Dokument sah anders aus. Beim Kunden wirkte der 12-Mann-Betrieb kleiner, als er ist.',
    approach: 'Migration auf Google Workspace mit eigener Domain, neues Logo, Angebots- und Briefvorlagen, E-Mail-Signaturen für das ganze Team — dokumentiert in einem kompakten CI-Manual.',
    result: 'Ein Erscheinungsbild vom Briefkopf bis zur E-Mail. Neue Mitarbeiter bekommen am ersten Tag eine fertige Adresse und die richtigen Vorlagen.',
    transfer: 'Handwerksbetriebe jeder Größe, die professioneller wirken wollen, als ihre Freemail-Adresse es zulässt.',
  },
  {
    title: 'Yogastudio Sonnenlicht',
    category: 'Webdesign — Kurse & Buchung',
    isReal: false,
    visual: { real: 'yogastudio-sonnenlicht', variant: 'brand' as const },
    visualAlt: 'Abstrakte Illustration aus Grundformen: Kreis, Quadrat und Dreieck in Violett',
    problem: 'Kursanmeldungen kamen per Instagram-DM, SMS und Zuruf. Die Inhaberin führte Teilnehmerlisten von Hand und verlor den Überblick über freie Plätze.',
    approach: 'Ruhige, minimalistische Website mit Kurskalender und Online-Buchung. Die Gestaltung nimmt die Atmosphäre des Studios auf, statt sie mit Effekten zu übertönen.',
    result: 'Buchungen laufen über den Kalender, Wartelisten füllen sich automatisch. Die Inhaberin unterrichtet, statt Listen zu pflegen.',
    transfer: 'Studios, Praxen und Kursanbieter mit festen Terminen und begrenzten Plätzen.',
  },
];
---

<style>
  .page-hero {
    position: relative;
    padding: clamp(4rem, 9vh, 7rem) 0 clamp(3rem, 6vh, 5rem);
  }
  .page-h1 {
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.0;
    margin: 1.25rem 0 1.5rem; max-width: 16ch;
    animation: fadeUp 650ms var(--ease-out) 140ms both;
  }
  .page-h1 .accent { color: var(--accent); }
  .page-hero-label { animation: fadeUp 500ms var(--ease-out) 60ms both; }
  .page-hero-sub {
    font-size: 1.125rem; color: var(--ink-2); line-height: 1.7;
    max-width: 52ch; margin: 0;
    animation: fadeUp 550ms var(--ease-out) 240ms both;
  }
  .page-hero-sub strong { color: var(--ink); font-weight: 600; }

  .case { scroll-margin-top: 90px; }
  .case:nth-of-type(even) { background: var(--paper-dim); }

  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .case-head { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; position: sticky; top: 100px; }
  .case-badge {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-strong); background: var(--tint);
    padding: 4px 10px; border-radius: var(--r-sm);
  }
  .case-badge.real { color: #fff; background: var(--accent); }
  .case-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.08; margin: 0;
  }
  .case-cat {
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3);
  }

  .case-body { display: flex; flex-direction: column; gap: 1.75rem; }
  .case-fields { display: flex; flex-direction: column; }
  .case-field {
    display: grid; grid-template-columns: 130px 1fr; gap: 1.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }
  .case-field:last-child { border-bottom: 1px solid var(--border); }
  .case-field-label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3);
    padding-top: 3px;
  }
  .case-field-text { font-size: 0.9688rem; color: var(--ink-2); line-height: 1.7; margin: 0; }
  .case-field.transfer .case-field-label { color: var(--accent); }
  .case-field.transfer .case-field-text { color: var(--ink); font-weight: 500; }

  @media (max-width: 820px) {
    .case-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .case-head { position: static; }
    .case-field { grid-template-columns: 1fr; gap: 4px; }
  }
</style>

<BaseLayout
  title="Arbeiten – Konzeptprojekte & eigene Projekte"
  description="Arbeiten von MB-Solutions: die eigene Website als erstes echtes Projekt und Konzeptprojekte, die zeigen, wie ich Webdesign, IT-Setup und Branding angehe."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://www.mb-solutions.biz" },
        { "@type": "ListItem", "position": 2, "name": "Arbeiten", "item": "https://www.mb-solutions.biz/portfolio" }
      ]
    })}</script>
  </Fragment>

  <Navbar />
  <main id="main-content">

    <section class="page-hero" aria-labelledby="port-heading">
      <DecoShapes variant="corner" />
      <div class="container-site">
        <p class="label-mono page-hero-label">Arbeiten</p>
        <h1 class="page-h1" id="port-heading">
          So gehe ich Projekte <span class="accent">an.</span>
        </h1>
        <p class="page-hero-sub">
          <strong>Offen gesagt:</strong> MB-Solutions ist frisch gestartet — hier
          stehen noch keine Kundenlogos. Das erste echte Projekt ist diese
          Website selbst. Dazu kommen drei Konzeptprojekte, die ehrlich zeigen,
          wie ich typische Aufgaben von Kölner Betrieben angehen würde.
        </p>
      </div>
    </section>

    {projects.map(p => (
      <section class="case section-pad" aria-label={`${p.isReal ? 'Projekt' : 'Konzeptprojekt'} ${p.title}`}>
        <div class="container-site">
          <div class="case-grid">
            <div class="case-head">
              <span class={`case-badge ${p.isReal ? 'real' : ''}`}>
                {p.isReal ? 'Echtes Projekt' : 'Konzeptprojekt'}
              </span>
              <h2 class="case-title reveal">{p.title}</h2>
              <span class="case-cat">{p.category}</span>
            </div>
            <div class="case-body">
              <div class="reveal">
                <ProjectVisual
                  real={p.visual.real}
                  variant={p.visual.variant}
                  alt={p.visualAlt}
                  caption={p.visualCaption}
                />
              </div>
              <div class="case-fields reveal">
                <div class="case-field">
                  <span class="case-field-label">Ausgangslage</span>
                  <p class="case-field-text">{p.problem}</p>
                </div>
                <div class="case-field">
                  <span class="case-field-label">Ansatz</span>
                  <p class="case-field-text">{p.approach}</p>
                </div>
                <div class="case-field">
                  <span class="case-field-label">Ergebnis</span>
                  <p class="case-field-text">{p.result}</p>
                </div>
                <div class="case-field transfer">
                  <span class="case-field-label">Passt zu</span>
                  <p class="case-field-text">{p.transfer}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
