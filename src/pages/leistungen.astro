---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import DecoShapes from '../components/DecoShapes.astro';

const services = [
  {
    id: 'webdesign',
    num: '01',
    title: 'Webdesign & Entwicklung',
    lead: 'Deine Website ist dein fleißigster Mitarbeiter: Sie ist rund um die Uhr erreichbar, beantwortet die häufigsten Fragen und sammelt Anfragen — wenn sie richtig gebaut ist.',
    outcome: 'Das Ergebnis: Ein Auftritt, der bei Google gefunden wird und aus Besuchern Anfragen macht.',
    items: [
      'Design & Entwicklung, mobil zuerst gedacht',
      'Struktur & Texte gemeinsam geschärft',
      'Lokales SEO — gefunden werden in Köln und Umgebung',
      'Schnelle Ladezeiten, saubere Technik',
      'Impressum & Datenschutz sauber gelöst',
      'Launch inkl. Domain- und Hosting-Setup',
    ],
  },
  {
    id: 'it-services',
    num: '02',
    title: 'IT-Services & Cloud',
    lead: 'Freemail-Adressen, Daten auf einem einzigen Rechner, Passwörter im Notizbuch — so arbeiten viele Betriebe. Bis etwas schiefgeht. Ich richte deine IT einmal ordentlich ein.',
    outcome: 'Das Ergebnis: Deine Technik läuft im Hintergrund — und wenn etwas klemmt, genügt ein Anruf.',
    items: [
      'Professionelle E-Mail-Adressen mit eigener Domain',
      'Microsoft 365 oder Google Workspace, sauber eingerichtet',
      'Cloud-Speicher & automatische Backups',
      'Geräte-Einrichtung direkt im Betrieb',
      'VPN & sicherer Zugriff von unterwegs',
      'Laufender Support — ohne Ticketsystem',
    ],
  },
  {
    id: 'branding',
    num: '03',
    title: 'Branding & Corporate Identity',
    lead: 'Wenn Angebot, Visitenkarte und Website drei verschiedene Handschriften haben, wirkt der beste Betrieb improvisiert. Ein konsistenter Auftritt schafft Wiedererkennung — und Vertrauen.',
    outcome: 'Das Ergebnis: Ein Erscheinungsbild, das überall gleich aussieht — vom Briefkopf bis zum Firmenwagen.',
    items: [
      'Logo-Design inkl. aller Dateiformate',
      'Farbpalette & Schriftsystem',
      'Visitenkarten, Briefpapier, Angebotsvorlagen',
      'E-Mail-Signaturen für das ganze Team',
      'Social-Media-Vorlagen',
      'Kompaktes CI-Manual zum Weitergeben',
    ],
  },
];

const packages = [
  {
    name: 'Starter',
    price: 'ab 790 €',
    sub: 'einmalig',
    body: 'Für Neugründungen und Betriebe, die einen soliden Online-Einstieg brauchen.',
    highlight: false,
    items: ['Bis zu 5 Unterseiten', 'Responsive Design', 'Kontaktformular', 'Basis-SEO-Setup', 'Launch inkl. Setup'],
  },
  {
    name: 'Professional',
    price: 'ab 1.490 €',
    sub: 'einmalig',
    body: 'Für etablierte Betriebe, die professionell auftreten und Anfragen generieren wollen.',
    highlight: true,
    items: ['Bis zu 12 Unterseiten', 'Inhalte selbst pflegbar (CMS)', 'Performance-Optimierung', 'SEO-Paket inkl. lokale Suche', 'Branding-Anpassung', '3 Monate Betreuung inklusive'],
  },
  {
    name: 'All-in-one',
    price: 'ab 2.490 €',
    sub: 'einmalig + laufend',
    body: 'Komplett-Lösung: Website, IT-Setup und Branding aus einer Hand.',
    highlight: false,
    items: ['Website ohne Seitenlimit', 'Komplettes Branding', 'IT-Setup & Cloud', 'E-Mail & Domain', 'Laufende Betreuung mit Priorität'],
  },
];
---

<style>
  /* ── Seiten-Hero ── */
  .page-hero {
    position: relative;
    padding: clamp(4rem, 9vh, 7rem) 0 clamp(3rem, 6vh, 5rem);
  }
  .page-hero-label { animation: fadeUp 500ms var(--ease-out) 60ms both; }
  .page-h1 {
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.0;
    margin: 1.25rem 0 1.5rem; max-width: 16ch;
    animation: fadeUp 650ms var(--ease-out) 140ms both;
  }
  .page-h1 .accent { color: var(--accent); }
  .page-hero-sub {
    font-size: 1.125rem; color: var(--ink-2); line-height: 1.7;
    max-width: 48ch; margin: 0 0 2rem;
    animation: fadeUp 550ms var(--ease-out) 240ms both;
  }
  .page-hero-ctas {
    display: flex; gap: 12px; flex-wrap: wrap;
    animation: fadeUp 550ms var(--ease-out) 320ms both;
  }

  /* ── Leistungsblöcke ── */
  .svc { scroll-margin-top: 90px; }
  .svc:nth-of-type(even) { background: var(--paper-dim); }
  .svc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .svc-num-row { display: flex; align-items: center; gap: 12px; }
  .svc-num {
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 0.14em; color: var(--accent);
  }
  .svc-glyph { display: block; flex-shrink: 0; }
  .svc-h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800; letter-spacing: -0.025em; line-height: 1.05;
    margin: 1rem 0 1.25rem;
  }
  .svc-lead { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.75; margin: 0 0 1.25rem; max-width: 48ch; }
  .svc-outcome {
    font-size: 1rem; color: var(--ink); line-height: 1.65; font-weight: 500;
    margin: 0 0 1.75rem; max-width: 46ch;
    padding-left: 14px; border-left: 2px solid var(--accent);
  }

  .svc-list { list-style: none; padding: 0; margin: 0; }
  .svc-list li {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 14px 4px;
    border-top: 1px solid var(--border);
    font-size: 0.9688rem; color: var(--ink-2); line-height: 1.6;
  }
  .svc-list li:last-child { border-bottom: 1px solid var(--border); }
  .svc-list svg { color: var(--accent); flex-shrink: 0; margin-top: 6px; }

  /* ── Pakete ── */
  .pkgs { background: var(--paper); }
  .pkgs-header { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); max-width: 40rem; }
  .pkgs-h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800; letter-spacing: -0.025em; line-height: 1.04;
    margin: 1.25rem 0 1rem;
  }
  .pkgs-sub { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.7; margin: 0; }

  .pkg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; align-items: stretch; }
  .pkg-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex; flex-direction: column;
  }
  .pkg-card.highlighted { border-color: var(--accent); border-width: 1.5px; }
  .pkg-flag {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-strong); margin-bottom: 12px;
  }
  .pkg-name { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 6px; }
  .pkg-price-row { display: flex; align-items: baseline; gap: 8px; margin-bottom: 1rem; }
  .pkg-price {
    font-family: var(--font-mono); font-size: 1.375rem; font-weight: 600;
    color: var(--accent-strong); letter-spacing: -0.01em;
  }
  .pkg-sub-label { font-size: 0.8125rem; color: var(--ink-3); }
  .pkg-body { font-size: 0.9063rem; color: var(--ink-2); line-height: 1.65; margin: 0 0 1.5rem; }
  .pkg-items {
    list-style: none; padding: 1.25rem 0 0; margin: 0 0 1.75rem;
    border-top: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 9px; flex: 1;
  }
  .pkg-items li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 0.875rem; color: var(--ink-2); line-height: 1.5;
  }
  .pkg-items svg { color: var(--accent); flex-shrink: 0; margin-top: 4px; }

  @media (max-width: 980px) { .pkg-grid { grid-template-columns: 1fr; } }
  @media (max-width: 820px) {
    .svc-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>

<BaseLayout
  title="Leistungen – Webdesign, IT & Branding"
  description="Leistungen von MB-Solutions: Webdesign, IT-Services und Branding für KMU in Köln. Transparente Festpreise ab 790 €."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>{JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://www.mb-solutions.biz" },
            { "@type": "ListItem", "position": 2, "name": "Leistungen", "item": "https://www.mb-solutions.biz/leistungen" }
          ]
        },
        {
          "@type": "Service",
          "name": "Webdesign & Entwicklung",
          "description": "Webdesign für KMU und Handwerksbetriebe in Köln: mobil optimiert, lokal auffindbar, zum Festpreis.",
          "provider": { "@id": "https://www.mb-solutions.biz/#business" },
          "areaServed": "Köln",
          "offers": [
            { "@type": "Offer", "name": "Starter", "price": "790", "priceCurrency": "EUR" },
            { "@type": "Offer", "name": "Professional", "price": "1490", "priceCurrency": "EUR" },
            { "@type": "Offer", "name": "All-in-one", "price": "2490", "priceCurrency": "EUR" }
          ]
        }
      ]
    })}</script>
  </Fragment>

  <Navbar />
  <main id="main-content">

    <!-- Seiten-Hero -->
    <section class="page-hero" aria-labelledby="ls-heading">
      <DecoShapes variant="corner" />
      <div class="container-site">
        <p class="label-mono page-hero-label">Leistungen</p>
        <h1 class="page-h1" id="ls-heading">
          Was ich für dich <span class="accent">tun kann.</span>
        </h1>
        <p class="page-hero-sub">
          Von der ersten Idee bis zur fertigen Website — und alles, was ein
          moderner Betrieb digital braucht. Zum Festpreis, ohne Überraschungen.
        </p>
        <div class="page-hero-ctas">
          <a href="/kontakt" class="btn-primary">Kostenloses Erstgespräch</a>
          <a href="#pakete" class="btn-ghost">Pakete ansehen</a>
        </div>
      </div>
    </section>

    <!-- Leistungsblöcke -->
    {services.map(s => (
      <section class="svc section-pad" id={s.id} aria-labelledby={`${s.id}-heading`}>
        <div class="container-site">
          <div class="svc-grid">
            <div>
              <div class="svc-num-row reveal">
                {s.id === 'webdesign' && (
                  <svg class="svc-glyph" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                    <rect x="2" y="3" width="18" height="16" rx="3" stroke="var(--accent)" stroke-width="2"/>
                    <path d="M2 8h18" stroke="var(--accent)" stroke-width="2"/>
                  </svg>
                )}
                {s.id === 'it-services' && (
                  <svg class="svc-glyph" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                    <circle cx="5" cy="17" r="3" stroke="var(--accent)" stroke-width="2"/>
                    <circle cx="17" cy="5" r="3" stroke="var(--accent)" stroke-width="2"/>
                    <path d="M7 15L15 7" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                )}
                {s.id === 'branding' && (
                  <svg class="svc-glyph" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                    <path d="M3 19l8-15l8 15Z" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round"/>
                  </svg>
                )}
                <span class="svc-num">{s.num}</span>
              </div>
              <h2 class="svc-h2 reveal" id={`${s.id}-heading`}>{s.title}</h2>
              <p class="svc-lead reveal">{s.lead}</p>
              <p class="svc-outcome reveal">{s.outcome}</p>
              <div class="reveal">
                <a href="/kontakt" class="link-arrow">
                  Projekt besprechen
                  <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                    <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>
            <ul class="svc-list reveal" aria-label={`Einzelleistungen ${s.title}`}>
              {s.items.map(item => (
                <li>
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))}

    <!-- Website-Pakete -->
    <section class="pkgs section-pad" id="pakete" aria-labelledby="pkg-heading">
      <div class="container-site">
        <div class="pkgs-header">
          <p class="label-mono reveal">Website-Pakete</p>
          <h2 class="pkgs-h2 reveal" id="pkg-heading">Drei Pakete, ein Festpreis.</h2>
          <p class="pkgs-sub reveal">
            Richtwerte für den Einstieg — was dein Projekt konkret kostet,
            legen wir vor dem Start verbindlich fest.
          </p>
        </div>

        <div class="pkg-grid">
          {packages.map(pkg => (
            <div class={`pkg-card reveal ${pkg.highlight ? 'highlighted' : ''}`}>
              {pkg.highlight && <span class="pkg-flag">Meistgewählt</span>}
              <h3 class="pkg-name">{pkg.name}</h3>
              <div class="pkg-price-row">
                <span class="pkg-price">{pkg.price}</span>
                <span class="pkg-sub-label">{pkg.sub}</span>
              </div>
              <p class="pkg-body">{pkg.body}</p>
              <ul class="pkg-items">
                {pkg.items.map(item => (
                  <li>
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {item}
                  </li>
                ))}
              </ul>
              <a href="/kontakt" class={pkg.highlight ? 'btn-primary' : 'btn-ghost'} style="justify-content:center;">
                Erstgespräch anfragen
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
