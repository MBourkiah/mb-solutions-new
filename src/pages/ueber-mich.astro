---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import PortraitSlot from '../components/PortraitSlot.astro';

const principles = [
  {
    title: 'Klartext statt Fachjargon',
    body: 'Du musst nicht wissen, was ein CMS ist. Ich erkläre alles so, dass du gute Entscheidungen treffen kannst — und den Rest übernehme ich.',
  },
  {
    title: 'Festpreis statt Überraschung',
    body: 'Vor dem Start bekommst du ein verbindliches Angebot. Was drinsteht, gilt — auch wenn ich mich mal verschätze.',
  },
  {
    title: 'Erreichbar statt abgetaucht',
    body: 'Kein Ticketsystem, keine Warteschleife. Du hast meine Nummer, und ich antworte innerhalb von 48 Stunden — meistens deutlich schneller.',
  },
];

const timeline = [
  { year: '2019', title: 'Erste Kundenprojekte', body: 'Einstieg in die Selbstständigkeit mit einfachen WordPress-Websites für lokale Betriebe.' },
  { year: '2021', title: 'Erweiterung auf IT-Services', body: 'Microsoft 365, Cloud-Setups und Netzwerkinstallationen kommen dazu — oft direkt aus Website-Projekten heraus.' },
  { year: '2023', title: 'Gründung MB-Solutions', body: 'Formale Gründung mit klarem Fokus: Webdesign, IT und Branding aus einer Hand für Kölner KMU.' },
  { year: '2024', title: 'Moderner Technik-Stack', body: 'Umstieg auf moderne Website-Technik, die schneller lädt und weniger Wartung braucht.' },
];

const tools = [
  { name: 'Astro & Next.js', use: 'Schnelle, wartungsarme Websites' },
  { name: 'WordPress', use: 'Wenn du Inhalte selbst pflegen willst' },
  { name: 'Microsoft 365 / Google Workspace', use: 'E-Mail, Kalender und Dateien im Betrieb' },
  { name: 'Figma', use: 'Design, Logos und Vorlagen' },
  { name: 'Tailwind CSS', use: 'Sauberes, konsistentes Styling' },
];
---

<style>
  .page-hero { padding: clamp(4rem, 9vh, 7rem) 0 clamp(3rem, 6vh, 5rem); }
  .page-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .page-hero-portrait {
    max-width: 360px; width: 100%; justify-self: end;
    animation: fadeUp 700ms var(--ease-out) 300ms both;
  }
  .page-hero-label { animation: fadeUp 500ms var(--ease-out) 60ms both; }
  .page-h1 {
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.0;
    margin: 1.25rem 0 1.5rem; max-width: 15ch;
    animation: fadeUp 650ms var(--ease-out) 140ms both;
  }
  .page-h1 .accent { color: var(--accent); }
  .page-hero-sub {
    font-size: 1.125rem; color: var(--ink-2); line-height: 1.75;
    max-width: 52ch; margin: 0 0 2rem;
    animation: fadeUp 550ms var(--ease-out) 240ms both;
  }
  .page-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; animation: fadeUp 550ms var(--ease-out) 320ms both; }

  /* Grundsätze */
  .principles { background: var(--paper-dim); }
  .principles-h2, .tl-h2, .tools-h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800; letter-spacing: -0.025em; line-height: 1.05;
    margin: 1rem 0 0;
  }
  .principles-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .principle {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: clamp(1.5rem, 3vw, 2rem);
  }
  .principle-title {
    font-size: 1.125rem; font-weight: 700; letter-spacing: -0.015em;
    margin: 0 0 0.625rem;
  }
  .principle-body { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.7; margin: 0; }

  /* Werdegang */
  .tl-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 5vw, 5rem); align-items: start;
    }
  .tl-side-text { font-size: 1rem; color: var(--ink-2); line-height: 1.7; max-width: 36ch; margin: 1.25rem 0 0; }
  .tl-list { display: flex; flex-direction: column; }
  .tl-item {
    display: grid; grid-template-columns: 72px 1fr; gap: 1.5rem;
    padding: 1.375rem 4px;
    border-top: 1px solid var(--border);
  }
  .tl-item:last-child { border-bottom: 1px solid var(--border); }
  .tl-year {
    font-family: var(--font-mono); font-size: 13px; font-weight: 600;
    color: var(--accent); padding-top: 3px;
  }
  .tl-title { font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.015em; margin: 0 0 4px; }
  .tl-body { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.65; margin: 0; }

  /* Werkzeuge */
  .tools { background: var(--paper-dim); }
  .tools-sub { font-size: 1rem; color: var(--ink-2); line-height: 1.7; max-width: 48ch; margin: 1rem 0 0; }
  .tools-list { display: flex; flex-direction: column; margin-top: clamp(2rem, 4vw, 3rem); }
  .tool-row {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 1.5rem;
    padding: 14px 4px; border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .tool-row:last-child { border-bottom: 1px solid var(--border); }
  .tool-name { font-family: var(--font-display); font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .tool-use { font-size: 0.9063rem; color: var(--ink-2); }

  @media (max-width: 820px) {
    .page-hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .page-hero-portrait { justify-self: start; max-width: 300px; }
    .principles-grid { grid-template-columns: 1fr; }
    .tl-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .tool-row { grid-template-columns: 1fr; gap: 2px; }
  }
</style>

<BaseLayout
  title="Über mich – Maurice Bourkiah"
  description="Maurice Bourkiah, MB-Solutions Köln: Webdesigner, Entwickler und IT-Berater. Warum ein direkter Ansprechpartner oft die bessere Agentur ist."
>
  <Navbar />
  <main id="main-content">

    <!-- Hero -->
    <section class="page-hero" aria-labelledby="about-heading">
      <div class="container-site">
        <div class="page-hero-grid">
          <div>
            <p class="label-mono page-hero-label">Über mich</p>
            <h1 class="page-h1" id="about-heading">
              Technik mit <span class="accent">Handschlag.</span>
            </h1>
            <p class="page-hero-sub">
              Ich bin Maurice Bourkiah — Webdesigner, Entwickler und IT-Berater
              aus Köln. Ich glaube, dass Handwerksbetriebe und kleine Unternehmen
              denselben professionellen Auftritt verdienen wie große Konzerne,
              ohne die großen Agentur-Budgets dafür zu brauchen. Deshalb arbeite
              ich direkt: keine Unterauftragnehmer, keine Projektleiter-Schicht,
              keine langen Kommunikationsketten.
            </p>
            <div class="page-hero-ctas">
              <a href="/kontakt" class="btn-primary">Kostenloses Erstgespräch</a>
              <a href="/portfolio" class="btn-ghost">Arbeiten ansehen</a>
            </div>
          </div>
          <div class="page-hero-portrait">
            <PortraitSlot />
          </div>
        </div>
      </div>
    </section>

    <!-- Grundsätze -->
    <section class="principles section-pad" aria-labelledby="principles-heading">
      <div class="container-site">
        <p class="label-mono reveal">Arbeitsweise</p>
        <h2 class="principles-h2 reveal" id="principles-heading">Drei Grundsätze, die gelten.</h2>
        <div class="principles-grid">
          {principles.map(p => (
            <div class="principle reveal">
              <h3 class="principle-title">{p.title}</h3>
              <p class="principle-body">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Werdegang -->
    <section class="section-pad" aria-labelledby="tl-heading">
      <div class="container-site">
        <div class="tl-grid">
          <div>
            <p class="label-mono reveal">Werdegang</p>
            <h2 class="tl-h2 reveal" id="tl-heading">Wie es dazu kam.</h2>
            <p class="tl-side-text reveal">
              Kein Quereinstieg über Nacht: MB-Solutions ist aus mehreren
              Jahren Projektarbeit für lokale Betriebe gewachsen.
            </p>
          </div>
          <div class="tl-list reveal">
            {timeline.map(t => (
              <div class="tl-item">
                <span class="tl-year">{t.year}</span>
                <div>
                  <h3 class="tl-title">{t.title}</h3>
                  <p class="tl-body">{t.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Werkzeuge -->
    <section class="tools section-pad" aria-labelledby="tools-heading">
      <div class="container-site">
        <p class="label-mono reveal">Werkzeuge</p>
        <h2 class="tools-h2 reveal" id="tools-heading">Womit ich arbeite.</h2>
        <p class="tools-sub reveal">
          Du musst davon nichts kennen — aber falls es dich interessiert:
          Das sind die Werkzeuge hinter meinen Projekten, und wofür ich sie einsetze.
        </p>
        <div class="tools-list reveal">
          {tools.map(t => (
            <div class="tool-row">
              <span class="tool-name">{t.name}</span>
              <span class="tool-use">{t.use}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
