---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import DecoShapes from '../components/DecoShapes.astro';

/** Preisrahmen — dieselben Zahlen wie /leistungen, hier als Antwort aufgebaut. */
const tiers = [
  {
    name: 'Kleiner Betriebsauftritt',
    price: 'ab 790 €',
    pages: 'bis 5 Seiten',
    fits: 'Handwerksbetriebe, Einzelunternehmen, Neugründungen. Wer gefunden werden und erreichbar sein will.',
    includes: [
      'Startseite, Leistungen, Über uns, Kontakt',
      'Mobil optimiert, Anruf-Button',
      'Google-Unternehmensprofil verknüpft',
      'Impressum & Datenschutz',
      'Domain, Hosting, Launch',
    ],
  },
  {
    name: 'Ausgebauter Auftritt',
    price: 'ab 1.490 €',
    pages: 'bis 12 Seiten',
    fits: 'Etablierte Betriebe mit mehreren Leistungen oder Standorten, die planbar Anfragen gewinnen wollen.',
    includes: [
      'Alles aus dem kleinen Auftritt',
      'Eigene Seite je Leistung oder Gewerk',
      'Inhalte selbst pflegbar (auf Wunsch)',
      'Lokales SEO für Köln und Umland',
      '3 Monate Betreuung inklusive',
    ],
    featured: true,
  },
  {
    name: 'Alles aus einer Hand',
    price: 'ab 2.490 €',
    pages: 'ohne Seitenlimit',
    fits: 'Wer Website, Erscheinungsbild und IT gleichzeitig ordnen will, statt drei Dienstleister zu koordinieren.',
    includes: [
      'Website ohne Seitenlimit',
      'Logo und Erscheinungsbild',
      'E-Mail, Cloud und Geräte-Setup',
      'Laufende Betreuung mit Priorität',
    ],
  },
];

/** Was den Preis bewegt — die ehrliche Antwort auf „kommt drauf an". */
const factors = [
  {
    factor: 'Anzahl der Seiten',
    effect: 'hoch',
    body: 'Fünf Seiten oder fünfzehn ist der größte Einzelfaktor. Jede Seite braucht Struktur, Text und Feinschliff.',
  },
  {
    factor: 'Texte',
    effect: 'mittel',
    body: 'Ich schreibe vor, du korrigierst — das ist im Preis. Wenn du eigene Texte lieferst, wird es günstiger, dauert aber meist länger.',
  },
  {
    factor: 'Fotos',
    effect: 'mittel',
    body: 'Handyfotos aus dem Betrieb kosten nichts. Ein Fotograf schlägt mit 400 bis 900 € zu Buche und lohnt sich nicht für jeden.',
  },
  {
    factor: 'Terminbuchung oder Shop',
    effect: 'hoch',
    body: 'Online-Buchung, Kalender oder Verkauf sind eigene Systeme. Das ist kein Aufschlag von 200 €, sondern ein eigener Projektteil.',
  },
  {
    factor: 'Selbst pflegen wollen',
    effect: 'niedrig',
    body: 'Ein Redaktionssystem einzurichten kostet etwas mehr. Viele wollen es gar nicht — dann lassen wir es weg.',
  },
  {
    factor: 'Mehrsprachigkeit',
    effect: 'hoch',
    body: 'Jede weitere Sprache verdoppelt die Textarbeit. Sinnvoll nur, wenn du wirklich Kunden in dieser Sprache hast.',
  },
];

const running = [
  { item: 'Domain', cost: '10–20 € pro Jahr', note: 'z. B. .de oder .biz' },
  { item: 'Hosting', cost: '0–15 € pro Monat', note: 'für viele Betriebsseiten reicht ein kostenfreier Tarif' },
  { item: 'Betreuung (optional)', cost: 'ab 39 € pro Monat', note: 'Updates, Sicherung, kleine Änderungen' },
  { item: 'E-Mail mit eigener Domain', cost: 'ab 6 € pro Postfach', note: 'Google Workspace oder Microsoft 365' },
];

const faqs = [
  {
    q: 'Warum nennen die meisten Agenturen keine Preise?',
    a: 'Weil der Aufwand tatsächlich stark schwankt und eine Zahl ohne Kontext irreführen kann. Der Nachteil für dich: Du kannst nicht vergleichen und musst erst telefonieren, um überhaupt zu wissen, ob du in der richtigen Größenordnung suchst. Deshalb stehen hier Richtwerte — mit der Erklärung, was sie bewegt.',
  },
  {
    q: 'Was kostet es, wenn ich schon eine Website habe?',
    a: 'Ein Relaunch liegt meist im gleichen Rahmen wie eine neue Seite, manchmal darunter, weil Texte und Bilder schon existieren. Wenn die bestehende Seite technisch in Ordnung ist und nur veraltet aussieht, reicht gelegentlich eine Überarbeitung für einen deutlich kleineren Betrag. Das sage ich dir nach einem Blick auf die Seite.',
  },
  {
    q: 'Gibt es Ratenzahlung?',
    a: 'Ja. Üblich ist bei mir: die Hälfte bei Projektstart, die andere Hälfte beim Launch. Bei größeren Projekten auch in drei Schritten. Das klären wir im Angebot, nicht hinterher.',
  },
  {
    q: 'Was ist mit laufenden Kosten?',
    a: 'Domain und Hosting fallen immer an — bei einer schlanken Betriebsseite sind das oft unter 30 € im Jahr, weil die Technik, die ich einsetze, ohne teure Server läuft. Betreuung ist optional. Kein Abo-Zwang: Du kannst die Seite auch komplett übernehmen und selbst betreiben.',
  },
  {
    q: 'Warum ist ein Baukasten wie Wix günstiger?',
    a: 'Weil du die Arbeit selbst machst. Ein Baukasten kostet 10 bis 25 € im Monat und deine Zeit — realistisch 20 bis 40 Stunden für ein brauchbares Ergebnis, plus laufende Pflege. Wenn du die Zeit hast und Spaß daran, ist das ein völlig legitimer Weg, und ich sage dir das auch. Wenn deine Zeit auf der Baustelle mehr wert ist, rechnet sich die Beauftragung schnell.',
  },
];

const canonical = 'https://www.mb-solutions.biz/webdesign-kosten/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.mb-solutions.biz' },
        { '@type': 'ListItem', position: 2, name: 'Was kostet eine Website?', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Service',
      name: 'Website erstellen lassen — Festpreis',
      provider: { '@id': 'https://www.mb-solutions.biz/#business' },
      areaServed: { '@type': 'City', name: 'Köln' },
      offers: tiers.map((t) => ({
        '@type': 'Offer',
        name: t.name,
        price: t.price.replace(/[^0-9]/g, ''),
        priceCurrency: 'EUR',
      })),
    },
  ],
};
---

<style>
  .page-hero { position: relative; padding: clamp(4rem, 9vh, 7rem) 0 clamp(3rem, 6vh, 5rem); }
  .crumb {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3);
    margin-bottom: 1.5rem;
    animation: fadeUp 500ms var(--ease-out) 40ms both;
  }
  .crumb a { color: var(--ink-3); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  .crumb span[aria-current] { color: var(--ink); }

  .page-h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.0;
    margin: 0 0 1.5rem; max-width: 18ch;
    animation: fadeUp 650ms var(--ease-out) 140ms both;
  }
  .page-h1 .accent { color: var(--accent); }

  /* Direkte Antwort zuerst — für Suchende und für KI-Zitate */
  .answer {
    background: var(--surface); border: 1px solid var(--border);
    border-left: 3px solid var(--accent); border-radius: var(--r-lg);
    padding: clamp(1.5rem, 3vw, 2rem); max-width: 62ch;
    animation: fadeUp 550ms var(--ease-out) 240ms both;
    display: flex; flex-direction: column; gap: 0.875rem;
  }
  .answer p { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.75; }
  .answer p:first-child { font-size: 1.1875rem; color: var(--ink); font-weight: 500; }
  .answer strong { color: var(--ink); font-weight: 600; }
  .page-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 2rem; animation: fadeUp 550ms var(--ease-out) 340ms both; }

  /* Staffelung */
  .tiers-header { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); max-width: 42rem; }
  .sec-h2 {
    font-size: clamp(2rem, 4vw, 3rem); font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.05; margin: 1.25rem 0 1rem;
  }
  .sec-sub { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.7; margin: 0; }

  .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; align-items: stretch; }
  .tier {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex; flex-direction: column;
  }
  .tier.featured { border-color: var(--accent); border-width: 1.5px; }
  .tier-flag {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-strong); margin-bottom: 12px;
  }
  .tier-name { font-size: 1.1875rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 6px; line-height: 1.25; }
  .tier-price-row { display: flex; align-items: baseline; gap: 10px; margin-bottom: 1rem; flex-wrap: wrap; }
  .tier-price { font-family: var(--font-mono); font-size: 1.375rem; font-weight: 600; color: var(--accent-strong); }
  .tier-pages { font-size: 0.8125rem; color: var(--ink-3); }
  .tier-fits { font-size: 0.9063rem; color: var(--ink-2); line-height: 1.65; margin: 0 0 1.5rem; }
  .tier-list {
    list-style: none; margin: 0 0 1.75rem; padding: 1.25rem 0 0;
    border-top: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 9px; flex: 1;
  }
  .tier-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 0.875rem; color: var(--ink-2); line-height: 1.5; }
  .tier-list svg { color: var(--accent); flex-shrink: 0; margin-top: 4px; }

  /* Faktoren */
  .factors { background: var(--paper-dim); }
  .factor-list { display: flex; flex-direction: column; }
  .factor-row {
    display: grid; grid-template-columns: 200px 128px 1fr; gap: 1.5rem;
    padding: 1.25rem 4px; border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .factor-list .factor-row:last-child { border-bottom: 1px solid var(--border); }
  .factor-name { font-family: var(--font-display); font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .factor-body { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.65; margin: 0; }
  .eff {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 3px 9px; border-radius: var(--r-sm); white-space: nowrap;
  }
  .eff::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: none; }
  .eff-hoch { color: var(--accent-strong); background: var(--tint); }
  .eff-mittel { color: #8a6a1f; background: #fbf3e2; }
  .eff-niedrig { color: var(--ink-2); background: rgba(30,27,46,0.06); }

  /* Laufende Kosten */
  .run-table { display: flex; flex-direction: column; margin-top: clamp(1.75rem, 3vw, 2.5rem); }
  .run-row {
    display: grid; grid-template-columns: 1fr 190px 1fr; gap: 1.5rem;
    padding: 14px 4px; border-top: 1px solid var(--border); align-items: baseline;
  }
  .run-table .run-row:last-child { border-bottom: 1px solid var(--border); }
  .run-item { font-family: var(--font-display); font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .run-cost { font-family: var(--font-mono); font-size: 0.9375rem; color: var(--accent-strong); font-weight: 600; }
  .run-note { font-size: 0.9063rem; color: var(--ink-2); }

  /* FAQ */
  .faq-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .faq-side { font-size: 1rem; color: var(--ink-2); line-height: 1.7; max-width: 34ch; margin: 0 0 1.75rem; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-item { border-top: 1px solid var(--border-2); }
  .faq-list .faq-item:last-child { border-bottom: 1px solid var(--border-2); }
  .faq-summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.25rem;
    padding: 1.375rem 4px; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600;
    color: var(--ink); letter-spacing: -0.015em; line-height: 1.35;
    transition: color 150ms var(--ease-out);
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary::marker { display: none; }
  @media (hover: hover) and (pointer: fine) { .faq-summary:hover { color: var(--accent-strong); } }
  .faq-icon { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--ink-3); transition: transform 260ms var(--ease-out), color 200ms var(--ease-out); }
  .faq-item[open] .faq-icon { transform: rotate(45deg); color: var(--accent); }
  .faq-body { padding: 0 4px 1.5rem; max-width: 62ch; }
  .faq-item[open] .faq-body { animation: fadeUp 260ms var(--ease-out) both; }
  .faq-body p { font-size: 0.9688rem; color: var(--ink-2); line-height: 1.75; margin: 0; }

  @media (max-width: 980px) { .tier-grid { grid-template-columns: 1fr; } }
  @media (max-width: 820px) {
    .factor-row { grid-template-columns: 1fr; gap: 6px; }
    .run-row { grid-template-columns: 1fr; gap: 4px; }
    .faq-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>

<BaseLayout
  title="Was kostet eine Website? Preise 2026"
  description="Was eine Website kostet: Richtwerte ab 790 €, dazu die sechs Faktoren, die den Preis bewegen, und die laufenden Kosten. Transparent gerechnet, ohne „Preis auf Anfrage“."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>

  <Navbar />
  <main id="main-content">

    <!-- Hero mit direkter Antwort -->
    <section class="page-hero" aria-labelledby="cost-heading">
      <DecoShapes variant="corner" />
      <div class="container-site">
        <nav class="crumb" aria-label="Brotkrumen-Navigation">
          <a href="/">Start</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Was kostet eine Website?</span>
        </nav>
        <h1 class="page-h1" id="cost-heading">
          Was kostet eine <span class="accent">Website?</span>
        </h1>
        <div class="answer">
          <p>
            Eine professionelle Website für einen kleinen Betrieb kostet bei mir
            <strong>ab 790 €</strong> als Festpreis. Umfangreichere Auftritte mit
            eigener Seite je Leistung liegen <strong>ab 1.490 €</strong>, die
            Komplettlösung mit Erscheinungsbild und IT <strong>ab 2.490 €</strong>.
          </p>
          <p>
            Laufend kommen Domain und Hosting hinzu — bei einer schlanken
            Betriebsseite oft unter 30 € im Jahr. Was dein Vorhaben konkret
            kostet, hängt vor allem an der Zahl der Seiten und daran, ob
            Terminbuchung oder Shop dazukommen. Beides steht weiter unten
            aufgeschlüsselt.
          </p>
        </div>
        <div class="page-hero-ctas">
          <a href="/kontakt" class="btn-primary">Festpreis anfragen</a>
          <a href="tel:+491718165966" class="btn-ghost">Kurz durchrufen</a>
        </div>
      </div>
    </section>

    <!-- Staffelung -->
    <section class="section-pad" aria-labelledby="tiers-heading">
      <div class="container-site">
        <div class="tiers-header">
          <p class="label-mono reveal">Preisrahmen</p>
          <h2 class="sec-h2 reveal" id="tiers-heading">Drei Größenordnungen.</h2>
          <p class="sec-sub reveal">
            Richtwerte für den Einstieg, keine Pauschalen. Verbindlich wird die
            Zahl im Angebot nach dem Erstgespräch — und dann gilt sie.
          </p>
        </div>
        <div class="tier-grid">
          {tiers.map(t => (
            <div class={`tier reveal ${t.featured ? 'featured' : ''}`}>
              {t.featured && <span class="tier-flag">Meistgewählt</span>}
              <h3 class="tier-name">{t.name}</h3>
              <div class="tier-price-row">
                <span class="tier-price">{t.price}</span>
                <span class="tier-pages">{t.pages}</span>
              </div>
              <p class="tier-fits">{t.fits}</p>
              <ul class="tier-list">
                {t.includes.map(i => (
                  <li>
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {i}
                  </li>
                ))}
              </ul>
              <a href="/kontakt" class={t.featured ? 'btn-primary' : 'btn-ghost'} style="justify-content:center;">
                Angebot anfragen
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Was den Preis bewegt -->
    <section class="factors section-pad" aria-labelledby="factors-heading">
      <div class="container-site">
        <div class="tiers-header">
          <p class="label-mono reveal">Preistreiber</p>
          <h2 class="sec-h2 reveal" id="factors-heading">Was den Preis bewegt — und wie stark.</h2>
          <p class="sec-sub reveal">
            „Kommt drauf an" ist keine Antwort. Es kommt auf sechs Dinge an,
            und das hier ist ihre Reihenfolge.
          </p>
        </div>
        <div class="factor-list reveal">
          {factors.map(f => (
            <div class="factor-row">
              <span class="factor-name">{f.factor}</span>
              <span>
                <span class={`eff eff-${f.effect}`}>{f.effect === 'hoch' ? 'Hoch' : f.effect === 'mittel' ? 'Mittel' : 'Gering'}</span>
              </span>
              <p class="factor-body">{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Laufende Kosten -->
    <section class="section-pad" aria-labelledby="run-heading">
      <div class="container-site">
        <div class="tiers-header">
          <p class="label-mono reveal">Laufende Kosten</p>
          <h2 class="sec-h2 reveal" id="run-heading">Was nach dem Launch weiterläuft.</h2>
          <p class="sec-sub reveal">
            Die Posten, die viele Angebote verschweigen. Bei mir stehen sie hier,
            bevor du fragen musst.
          </p>
        </div>
        <div class="run-table reveal">
          {running.map(r => (
            <div class="run-row">
              <span class="run-item">{r.item}</span>
              <span class="run-cost">{r.cost}</span>
              <span class="run-note">{r.note}</span>
            </div>
          ))}
        </div>
        <p class="sec-sub reveal" style="margin-top:1.75rem;max-width:64ch;">
          Kein Abo-Zwang: Die Betreuung ist optional, und du kannst die Seite
          jederzeit vollständig übernehmen und selbst betreiben.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="factors section-pad" aria-labelledby="faq-heading">
      <div class="container-site">
        <div class="faq-grid">
          <div>
            <p class="label-mono reveal">Häufige Fragen</p>
            <h2 class="sec-h2 reveal" id="faq-heading">Fragen zum Preis.</h2>
            <p class="faq-side reveal">
              Auch die unbequemen — inklusive der Frage, wann ein Baukasten
              für dich die bessere Wahl ist.
            </p>
            <div class="reveal">
              <a href="/leistungen/webdesign-handwerker" class="link-arrow">
                Speziell für Handwerksbetriebe
                <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="faq-list reveal">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-summary">
                  <span>{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </span>
                </summary>
                <div class="faq-body"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
