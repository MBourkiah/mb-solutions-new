---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';

const contacts = [
  { label: 'Telefon',     value: '+49 171 816 59 66',            href: 'tel:+491718165966' },
  { label: 'E-Mail',      value: 'mbourkiah@mb-solutions.biz',   href: 'mailto:mbourkiah@mb-solutions.biz' },
  { label: 'WhatsApp',    value: 'Direkt schreiben',             href: 'https://wa.me/491718165966' },
  { label: 'Standort',    value: 'Köln, Deutschland',            href: null },
];

const promises = [
  'Kostenloses Erstgespräch ohne Verkaufsdruck',
  'Klares Festpreisangebot vor Projektstart',
  'Du sprichst direkt mit dem, der es baut',
  'Persönliche Treffen in Köln möglich',
];
---

<style>
  .kontakt { padding: clamp(4rem, 9vh, 7rem) 0 clamp(4rem, 8vw, 7rem); }
  .kontakt-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .kt-label { animation: fadeUp 500ms var(--ease-out) 60ms both; }
  .kt-h1 {
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.0;
    margin: 1.25rem 0 1.5rem;
    animation: fadeUp 650ms var(--ease-out) 140ms both;
  }
  .kt-h1 .accent { color: var(--accent); }
  .kt-sub {
    font-size: 1.0625rem; color: var(--ink-2); line-height: 1.75;
    max-width: 42ch; margin: 0 0 2.5rem;
    animation: fadeUp 550ms var(--ease-out) 240ms both;
  }

  .kt-contacts {
    display: flex; flex-direction: column;
    margin-bottom: 2.5rem;
    animation: fadeUp 550ms var(--ease-out) 320ms both;
  }
  .kt-row {
    display: grid; grid-template-columns: 110px 1fr; gap: 1.25rem;
    align-items: baseline;
    padding: 14px 4px;
    border-top: 1px solid var(--border);
    text-decoration: none;
    transition: background 150ms var(--ease-out);
  }
  .kt-contacts .kt-row:last-child { border-bottom: 1px solid var(--border); }
  a.kt-row:hover { background: var(--surface); }
  .kt-row-label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3);
  }
  .kt-row-value { font-size: 1rem; color: var(--ink); font-weight: 500; }
  a.kt-row .kt-row-value { transition: color 150ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    a.kt-row:hover .kt-row-value { color: var(--accent-strong); }
  }

  .kt-promises {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 10px;
    animation: fadeUp 550ms var(--ease-out) 400ms both;
  }
  .kt-promises li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 0.9375rem; color: var(--ink-2); line-height: 1.55;
  }
  .kt-promises svg { color: var(--accent); flex-shrink: 0; margin-top: 5px; }

  .kt-form-col { animation: fadeUp 700ms var(--ease-out) 300ms both; }

  @media (max-width: 860px) {
    .kontakt-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>

<BaseLayout
  title="Kontakt – MB-Solutions Köln"
  description="Kontaktiere MB-Solutions für Webdesign, IT-Services und Branding in Köln. Kostenloses Erstgespräch vereinbaren."
>
  <Navbar />
  <main id="main-content">
    <section class="kontakt" aria-labelledby="kontakt-heading">
      <div class="container-site">
        <div class="kontakt-grid">

          <!-- Links: Info -->
          <div>
            <p class="label-mono kt-label">Kontakt</p>
            <h1 class="kt-h1" id="kontakt-heading">
              Lass uns <span class="accent">reden.</span>
            </h1>
            <p class="kt-sub">
              Schreib mir eine Nachricht oder ruf direkt an — du bekommst
              innerhalb von 48 Stunden eine ehrliche Einschätzung.
            </p>

            <div class="kt-contacts">
              {contacts.map(c => c.href ? (
                <a href={c.href} class="kt-row" {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  <span class="kt-row-label">{c.label}</span>
                  <span class="kt-row-value">{c.value}</span>
                </a>
              ) : (
                <div class="kt-row">
                  <span class="kt-row-label">{c.label}</span>
                  <span class="kt-row-value">{c.value}</span>
                </div>
              ))}
            </div>

            <ul class="kt-promises" aria-label="Was dich erwartet">
              {promises.map(item => (
                <li>
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Rechts: Formular -->
          <div class="kt-form-col">
            <ContactForm />
          </div>

        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
