---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import DecoShapes from '../components/DecoShapes.astro';

const links = [
  { href: '/',           label: 'Startseite',  desc: 'Der Überblick über alles' },
  { href: '/leistungen', label: 'Leistungen',  desc: 'Webdesign, IT-Services, Branding' },
  { href: '/portfolio',  label: 'Arbeiten',    desc: 'Projekte und Arbeitsweise' },
  { href: '/kontakt',    label: 'Kontakt',     desc: 'Kostenloses Erstgespräch anfragen' },
];
---

<style>
  .nf {
    position: relative;
    min-height: calc(100svh - 77px);
    display: flex; align-items: center;
    padding-block: clamp(3rem, 8vh, 6rem);
  }

  .nf-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    width: 100%;
  }

  .nf-label { animation: fadeUp 500ms var(--ease-out) 60ms both; }

  /* 404 im Offset-Print-Motiv der Illustrationen */
  .nf-code {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(6rem, 18vw, 13rem);
    font-weight: 800; letter-spacing: -0.04em; line-height: 0.95;
    color: var(--accent);
    margin: 0.5rem 0 1rem;
    width: fit-content;
    animation: fadeUp 650ms var(--ease-out) 140ms both;
  }
  .nf-code-offset {
    position: absolute; top: 0.045em; left: 0.045em;
    color: transparent;
    -webkit-text-stroke: 2px var(--deep);
    z-index: -1;
    opacity: 0.55;
  }

  .nf-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700; letter-spacing: -0.02em; line-height: 1.15;
    margin: 0 0 1rem;
    animation: fadeUp 550ms var(--ease-out) 220ms both;
  }
  .nf-sub {
    font-size: 1.0625rem; color: var(--ink-2); line-height: 1.7;
    max-width: 42ch; margin: 0 0 2rem;
    animation: fadeUp 550ms var(--ease-out) 300ms both;
  }
  .nf-ctas {
    display: flex; gap: 12px; flex-wrap: wrap;
    animation: fadeUp 550ms var(--ease-out) 380ms both;
  }

  /* Linkliste im Stil des Hero-Index */
  .nf-index {
    display: flex; flex-direction: column;
    animation: fadeUp 600ms var(--ease-out) 460ms both;
  }
  .nf-index-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px; align-items: center;
    padding: 15px 4px;
    border-top: 1px solid var(--border);
    text-decoration: none;
    transition: background 160ms var(--ease-out), padding-left 200ms var(--ease-out);
  }
  .nf-index-item:last-child { border-bottom: 1px solid var(--border); }
  .nfi-main { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .nfi-label {
    font-family: var(--font-display); font-size: 1.0625rem; font-weight: 700;
    letter-spacing: -0.015em; color: var(--ink);
  }
  .nfi-desc { font-size: 13px; color: var(--ink-2); }
  .nfi-arrow {
    color: var(--ink-3);
    transition: transform 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .nf-index-item:hover { padding-left: 12px; background: var(--surface); }
    .nf-index-item:hover .nfi-arrow { transform: translateX(3px); color: var(--accent); }
    .nf-index-item:hover .nfi-label { color: var(--accent-strong); }
  }

  @media (max-width: 820px) {
    .nf { min-height: 0; }
    .nf-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>

<BaseLayout
  title="Seite nicht gefunden"
  description="Diese Seite gibt es nicht (mehr). Hier geht es zurück zu MB-Solutions."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <Navbar />
  <main id="main-content">
    <section class="nf" aria-labelledby="nf-heading">
      <DecoShapes variant="corner" />
      <div class="container-site" style="width:100%;">
        <div class="nf-grid">
          <div>
            <p class="label-mono nf-label">Fehler 404</p>
            <div class="nf-code" aria-hidden="true">
              404
              <span class="nf-code-offset" aria-hidden="true">404</span>
            </div>
            <h1 class="nf-title" id="nf-heading">Diese Seite gibt es nicht.</h1>
            <p class="nf-sub">
              Vielleicht vertippt, vielleicht verschoben — jedenfalls führt
              dieser Link ins Leere. Kein Drama: Alles Wichtige ist eine
              Abzweigung entfernt.
            </p>
            <div class="nf-ctas">
              <a href="/" class="btn-primary">Zur Startseite</a>
              <a href="/kontakt" class="btn-ghost">Problem melden</a>
            </div>
          </div>

          <nav class="nf-index" aria-label="Wichtige Seiten">
            {links.map(l => (
              <a href={l.href} class="nf-index-item">
                <span class="nfi-main">
                  <span class="nfi-label">{l.label}</span>
                  <span class="nfi-desc">{l.desc}</span>
                </span>
                <svg class="nfi-arrow" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
