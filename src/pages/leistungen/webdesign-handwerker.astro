---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';
import DecoShapes from '../../components/DecoShapes.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';

/** Was eine Handwerker-Website leisten muss — konkret, nicht generisch. */
const requirements = [
  {
    title: 'Anrufen mit einem Daumendruck',
    body: 'Wer am Straßenrand mit einem tropfenden Rohr im Keller sucht, will nicht lesen. Die Telefonnummer steht oben, ist ein Knopf, und der Anruf startet mit einem Tippen.',
  },
  {
    title: 'Gewerke, die man sofort erkennt',
    body: 'Nicht „ganzheitliche Lösungen", sondern: Heizung, Sanitär, Bad-Sanierung, Notdienst. Kunden suchen nach dem, was sie brauchen — und müssen es in drei Sekunden finden.',
  },
  {
    title: 'Einsatzgebiet klar benannt',
    body: 'Köln, Leverkusen, Bergisch Gladbach — wo du fährst und wo nicht. Das spart dir Anfragen, die du ohnehin ablehnen müsstest, und hilft Google beim lokalen Einordnen.',
  },
  {
    title: 'Fotos von echter Arbeit',
    body: 'Kein Stockfoto mit lächelndem Modell in sauberer Latzhose. Deine Baustellen, deine fertigen Bäder. Falls du keine hast: Handy reicht, ich sage dir, was ich brauche.',
  },
  {
    title: 'Anfragen, die ankommen',
    body: 'Ein Formular, das auf deinem Handy landet — nicht in einem Postfach, das keiner öffnet. Auf Wunsch mit WhatsApp, weil das für viele Kunden die niedrigste Hürde ist.',
  },
  {
    title: 'Google-Profil verknüpft',
    body: 'Öffnungszeiten, Karte, Bewertungen. Bei lokalen Suchen entscheidet das Google-Profil oft mehr als die Website — ich richte beides so ein, dass es zusammenspielt.',
  },
];

/** Ablauf, zugeschnitten auf Leute, die tagsüber auf der Baustelle sind. */
const steps = [
  {
    num: '01',
    title: 'Ein Telefonat, 20 Minuten',
    body: 'Abends oder in der Mittagspause, wie es dir passt. Du erzählst, was du machst und für wen. Ich frage nach, was ich für die Struktur brauche — kein Fachjargon, keine Hausaufgaben.',
  },
  {
    num: '02',
    title: 'Ich baue, du schaust drauf',
    body: 'Du bekommst ein Festpreisangebot, danach lege ich los. Texte schreibe ich vor, du korrigierst, was nicht stimmt. Das ist weniger Aufwand als ein Angebot zu schreiben.',
  },
  {
    num: '03',
    title: 'Online — und ich bleibe erreichbar',
    body: 'Neue Leistung, neue Fotos, Preise geändert? Anruf genügt. Kein Ticketsystem, kein Support-Center, keine Wartezeit.',
  },
];

const faqs = [
  {
    q: 'Ich habe keine Fotos von meinen Projekten.',
    a: 'Das ist der Normalfall. Handyfotos reichen völlig aus, wenn das Licht passt — ich sage dir vorher, welche Motive wirken: fertige Arbeiten, der Firmenwagen, du selbst. Und solange nichts da ist, baue ich die Seite so, dass sie ohne Fotos funktioniert und später welche aufnehmen kann.',
  },
  {
    q: 'Ich habe keine Zeit für so ein Projekt.',
    a: 'Dein Aufwand liegt bei etwa zwei Stunden verteilt über drei Wochen: ein Telefonat am Anfang, einmal Texte durchlesen, einmal Freigabe. Alles andere übernehme ich. Wenn du mehr Zeit investieren müsstest, hätte ich meinen Job nicht gemacht.',
  },
  {
    q: 'Ich habe genug Aufträge. Brauche ich das überhaupt?',
    a: 'Dann ist der ehrlichste Rat: nicht dringend. Sinnvoll wird es, wenn du Aufträge auswählen statt annehmen willst — bessere Kunden, passendere Projekte — oder wenn du Mitarbeiter suchst. Bewerber schauen sich Betriebe heute vorher an. Wenn beides gerade nicht dein Thema ist, sag ich dir das im Erstgespräch auch so.',
  },
  {
    q: 'Was passiert, wenn ich später etwas ändern will?',
    a: 'Kleinigkeiten wie Öffnungszeiten, Preise oder eine neue Leistung mache ich meist am selben Tag. Auf Wunsch richte ich die Seite so ein, dass du Texte und Bilder selbst pflegen kannst — muss aber nicht, viele wollen genau das nicht.',
  },
  {
    q: 'Warum du und nicht eine Agentur?',
    a: 'Bei mir sprichst du mit dem, der die Seite baut. Keine Projektleiter-Schicht, keine wechselnden Ansprechpartner, keine Unterauftragnehmer. Dafür bin ich auch nur einer — bei einem Projekt mit zehn Beteiligten wäre eine Agentur die richtige Wahl.',
  },
];

const canonical = 'https://www.mb-solutions.biz/leistungen/webdesign-handwerker/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.mb-solutions.biz' },
        { '@type': 'ListItem', position: 2, name: 'Leistungen', item: 'https://www.mb-solutions.biz/leistungen' },
        { '@type': 'ListItem', position: 3, name: 'Webdesign für Handwerker', item: canonical },
      ],
    },
    {
      '@type': 'Service',
      name: 'Webdesign für Handwerker',
      serviceType: 'Webdesign für Handwerksbetriebe',
      description:
        'Websites für Handwerksbetriebe in Köln und Umgebung: mobil bedienbar, lokal auffindbar, zum Festpreis. Umsetzung durch einen direkten Ansprechpartner.',
      provider: { '@id': 'https://www.mb-solutions.biz/#business' },
      areaServed: [
        { '@type': 'City', name: 'Köln' },
        { '@type': 'City', name: 'Leverkusen' },
        { '@type': 'City', name: 'Bergisch Gladbach' },
      ],
      audience: { '@type': 'Audience', audienceType: 'Handwerksbetriebe' },
      offers: {
        '@type': 'Offer',
        price: '790',
        priceCurrency: 'EUR',
        description: 'Website für Handwerksbetriebe, Festpreis ab 790 €',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<style>
  /* ── Hero ── */
  .page-hero { position: relative; padding: clamp(4rem, 9vh, 7rem) 0 clamp(3rem, 6vh, 5rem); }
  .crumb {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3);
    margin-bottom: 1.5rem;
    animation: fadeUp 500ms var(--ease-out) 40ms both;
  }
  .crumb a { color: var(--ink-3); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  .crumb span[aria-current] { color: var(--ink); }

  .page-h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.0;
    margin: 0 0 1.5rem; max-width: 20ch;
    animation: fadeUp 650ms var(--ease-out) 140ms both;
  }
  .page-h1 .accent { color: var(--accent); }
  .page-hero-sub {
    font-size: 1.125rem; color: var(--ink-2); line-height: 1.7;
    max-width: 50ch; margin: 0 0 2rem;
    animation: fadeUp 550ms var(--ease-out) 240ms both;
  }
  .page-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; animation: fadeUp 550ms var(--ease-out) 320ms both; }

  /* ── Ausgangslage (dunkel) ── */
  .problem { position: relative; background: var(--deep); color: var(--on-deep); }
  .problem-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem); align-items: center;
  }
  .problem-h2 {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem); font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.08; margin: 1.25rem 0 0;
    color: var(--on-deep);
  }
  .problem-text { display: flex; flex-direction: column; gap: 1.125rem; }
  .problem-text p { font-size: 1.0625rem; color: var(--on-deep-2); line-height: 1.75; }
  .problem-text strong { color: var(--on-deep); font-weight: 600; }

  /* ── Anforderungen ── */
  .req-header { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); max-width: 44rem; }
  .req-h2 {
    font-size: clamp(2rem, 4vw, 3rem); font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.05; margin: 1.25rem 0 1rem;
  }
  .req-sub { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.7; margin: 0; }
  .req-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .req {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: clamp(1.5rem, 3vw, 2rem);
    display: flex; flex-direction: column; gap: 0.625rem;
  }
  .req-title { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.015em; margin: 0; }
  .req-body { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.7; margin: 0; }

  /* ── Ablauf ── */
  .flow { background: var(--paper-dim); }
  .flow-header { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); max-width: 40rem; }
  .flow-h2 {
    font-size: clamp(2rem, 4vw, 3rem); font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.05; margin: 1.25rem 0 1rem;
  }
  .flow-sub { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.7; margin: 0; }
  .flow-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .flow-step { display: flex; flex-direction: column; gap: 0.75rem; padding-top: 1.25rem; border-top: 2px solid var(--accent); }
  .flow-num { font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; color: var(--accent); }
  .flow-title { font-size: 1.1875rem; font-weight: 700; letter-spacing: -0.015em; margin: 0; }
  .flow-body { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.7; margin: 0; }

  /* ── Preis ── */
  .price-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem); align-items: start;
  }
  .price-h2 {
    font-size: clamp(2rem, 4vw, 3rem); font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.05; margin: 1.25rem 0 1.25rem;
  }
  .price-text { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.75; margin: 0 0 1.25rem; max-width: 46ch; }
  .price-card {
    background: var(--surface); border: 1.5px solid var(--accent);
    border-radius: var(--r-lg); padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex; flex-direction: column; gap: 1.25rem;
  }
  .price-top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .price-name { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
  .price-tag { font-family: var(--font-mono); font-size: 1.375rem; font-weight: 600; color: var(--accent-strong); white-space: nowrap; }
  .price-list { list-style: none; margin: 0; padding: 1.25rem 0 0; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px; }
  .price-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 0.9375rem; color: var(--ink-2); line-height: 1.55; }
  .price-list svg { color: var(--accent); flex-shrink: 0; margin-top: 5px; }
  .price-note { font-size: 0.875rem; color: var(--ink-3); line-height: 1.6; margin: 0; }

  /* ── Referenz ── */
  .ref { background: var(--paper-dim); }
  .ref-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem); align-items: center;
  }
  .ref-h2 { font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; letter-spacing: -0.025em; line-height: 1.08; margin: 1.25rem 0 1.25rem; }
  .ref-text { font-size: 1rem; color: var(--ink-2); line-height: 1.75; margin: 0 0 1.25rem; max-width: 46ch; }
  .ref-text strong { color: var(--ink); font-weight: 600; }

  /* ── FAQ ── */
  .faq-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  /* Kleiner als die übrigen H2: steht in der schmalen linken Spalte */
  .faq-h2 { font-size: clamp(1.75rem, 2.8vw, 2.25rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 1.25rem 0 1.25rem; }
  .faq-side { font-size: 1rem; color: var(--ink-2); line-height: 1.7; max-width: 34ch; margin: 0 0 1.75rem; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-item { border-top: 1px solid var(--border-2); }
  .faq-list .faq-item:last-child { border-bottom: 1px solid var(--border-2); }
  .faq-summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.25rem;
    padding: 1.375rem 4px; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600;
    color: var(--ink); letter-spacing: -0.015em; line-height: 1.35;
    transition: color 150ms var(--ease-out);
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary::marker { display: none; }
  @media (hover: hover) and (pointer: fine) { .faq-summary:hover { color: var(--accent-strong); } }
  .faq-icon { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--ink-3); transition: transform 260ms var(--ease-out), color 200ms var(--ease-out); }
  .faq-item[open] .faq-icon { transform: rotate(45deg); color: var(--accent); }
  .faq-body { padding: 0 4px 1.5rem; max-width: 62ch; }
  .faq-item[open] .faq-body { animation: fadeUp 260ms var(--ease-out) both; }
  .faq-body p { font-size: 0.9688rem; color: var(--ink-2); line-height: 1.75; margin: 0; }

  @media (max-width: 900px) {
    .req-grid, .flow-list { grid-template-columns: 1fr; }
  }
  @media (min-width: 600px) and (max-width: 900px) {
    .flow-list { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 820px) {
    .problem-grid, .price-grid, .ref-grid, .faq-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>

<BaseLayout
  title="Webdesign für Handwerker in Köln"
  description="Webdesign für Handwerksbetriebe in Köln: mobil bedienbar, lokal auffindbar, zum Festpreis ab 790 €. Du sprichst direkt mit dem, der die Seite baut."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>

  <Navbar />
  <main id="main-content">

    <!-- Hero -->
    <section class="page-hero" aria-labelledby="hw-heading">
      <DecoShapes variant="corner" />
      <div class="container-site">
        <nav class="crumb" aria-label="Brotkrumen-Navigation">
          <a href="/">Start</a>
          <span aria-hidden="true">/</span>
          <a href="/leistungen">Leistungen</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Webdesign für Handwerker</span>
        </nav>
        <h1 class="page-h1" id="hw-heading">
          Webdesign für <span class="accent">Handwerker</span> in Köln.
        </h1>
        <p class="page-hero-sub">
          Eine Website, die dir Anfragen bringt statt Arbeit macht. Festpreis,
          drei Wochen, ein Ansprechpartner — und du sprichst direkt mit dem,
          der sie baut.
        </p>
        <div class="page-hero-ctas">
          <a href="/kontakt" class="btn-primary">Kostenloses Erstgespräch</a>
          <a href="tel:+491718165966" class="btn-ghost">Direkt anrufen</a>
        </div>
      </div>
    </section>

    <!-- Ausgangslage -->
    <section class="problem section-pad on-deep" aria-labelledby="problem-heading">
      <DecoShapes variant="deep" />
      <div class="container-site">
        <div class="problem-grid">
          <div>
            <p class="label-mono">Ausgangslage</p>
            <h2 class="problem-h2" id="problem-heading">
              Der Kunde sucht am Straßenrand. Nicht am Schreibtisch.
            </h2>
          </div>
          <div class="problem-text">
            <p>
              Heizung ausgefallen, Rohr undicht, Bad muss raus: Die Suche
              startet auf dem Handy, oft im Stehen, meistens eilig. Was dann
              zählt, ist banal — <strong>wer erscheint, wirkt seriös und ist
              mit einem Tippen erreichbar?</strong>
            </p>
            <p>
              Betriebe ohne Website tauchen bei dieser Suche schlicht nicht
              auf. Betriebe mit einer Seite, die auf dem Handy nicht lesbar
              ist oder deren Telefonnummer man abschreiben muss, verlieren
              den Anruf an den Nächsten in der Liste.
            </p>
            <p>
              Das ist kein Marketing-Problem, sondern ein Handwerks-Problem:
              Deine Arbeit überzeugt vor Ort. Sie muss nur vorher gefunden werden.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Anforderungen -->
    <section class="section-pad" aria-labelledby="req-heading">
      <div class="container-site">
        <div class="req-header">
          <p class="label-mono reveal">Was zählt</p>
          <h2 class="req-h2 reveal" id="req-heading">Sechs Dinge, die eine Handwerker-Website können muss.</h2>
          <p class="req-sub reveal">
            Nicht Animationen und nicht „digitale Erlebnisse". Sondern das,
            was bei einer eiligen Suche auf dem Handy tatsächlich den Anruf entscheidet.
          </p>
        </div>
        <div class="req-grid">
          {requirements.map(r => (
            <article class="req reveal">
              <h3 class="req-title">{r.title}</h3>
              <p class="req-body">{r.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ablauf -->
    <section class="flow section-pad" aria-labelledby="flow-heading">
      <div class="container-site">
        <div class="flow-header">
          <p class="label-mono reveal">Ablauf</p>
          <h2 class="flow-h2 reveal" id="flow-heading">Dein Aufwand: rund zwei Stunden.</h2>
          <p class="flow-sub reveal">
            Du bist tagsüber auf der Baustelle. Der Ablauf ist darauf ausgelegt,
            dass du so wenig wie möglich damit zu tun hast.
          </p>
        </div>
        <div class="flow-list">
          {steps.map(s => (
            <article class="flow-step reveal">
              <span class="flow-num">{s.num}</span>
              <h3 class="flow-title">{s.title}</h3>
              <p class="flow-body">{s.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Preis -->
    <section class="section-pad" aria-labelledby="price-heading">
      <div class="container-site">
        <div class="price-grid">
          <div>
            <p class="label-mono reveal">Preis</p>
            <h2 class="price-h2 reveal" id="price-heading">Festpreis, vor dem Start.</h2>
            <p class="price-text reveal">
              Kein Stundensatz, bei dem am Ende eine Überraschung steht. Nach
              dem Erstgespräch bekommst du eine Zahl, und die gilt — auch wenn
              ich mich verschätze.
            </p>
            <div class="reveal">
              <a href="/webdesign-kosten" class="link-arrow">
                Was eine Website kostet — im Detail
                <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="price-card reveal">
            <div class="price-top">
              <h3 class="price-name">Website für Handwerksbetriebe</h3>
              <span class="price-tag">ab 790 €</span>
            </div>
            <ul class="price-list">
              {[
                'Struktur, Texte und Gestaltung — von mir vorbereitet',
                'Auf dem Handy genauso bedienbar wie am PC',
                'Gewerke, Einsatzgebiet und Kontakt klar aufgebaut',
                'Google-Unternehmensprofil verknüpft und eingerichtet',
                'Impressum und Datenschutz rechtssicher gelöst',
                'Domain, Hosting und Launch inklusive',
              ].map(item => (
                <li>
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {item}
                </li>
              ))}
            </ul>
            <p class="price-note">
              Richtwert für einen überschaubaren Betriebsauftritt. Mehr Seiten,
              Online-Terminbuchung oder ein Shop verschieben den Preis — was
              dein Vorhaben konkret kostet, klären wir im Erstgespräch.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Referenz (ehrlich gekennzeichnet) -->
    <section class="ref section-pad" aria-labelledby="ref-heading">
      <div class="container-site">
        <div class="ref-grid">
          <div>
            <p class="label-mono reveal">Arbeitsweise</p>
            <h2 class="ref-h2 reveal" id="ref-heading">So gehe ich einen Handwerksbetrieb an.</h2>
            <p class="ref-text reveal">
              <strong>Offen gesagt:</strong> MB-Solutions ist frisch gestartet,
              hier steht noch kein Kundenlogo. Dieses Konzeptprojekt zeigt
              dafür konkret, wie ich einen Betrieb wie deinen angehen würde —
              von der Freemail-Adresse bis zum einheitlichen Auftritt.
            </p>
            <div class="reveal">
              <a href="/portfolio" class="link-arrow">
                Alle Projekte ansehen
                <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="reveal">
            <ProjectVisual
              real="keller-soehne"
              variant="it"
              alt="Abstrakte Illustration: verstreute Elemente laufen in eine geordnete Struktur zusammen"
              caption="Konzeptprojekt · Keller & Söhne GmbH"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-pad" aria-labelledby="faq-heading">
      <div class="container-site">
        <div class="faq-grid">
          <div>
            <p class="label-mono reveal">Häufige Fragen</p>
            <h2 class="faq-h2 reveal" id="faq-heading">Was Handwerker meistens fragen.</h2>
            <p class="faq-side reveal">
              Die fünf Einwände, die im Erstgespräch am häufigsten kommen —
              samt der Antwort, die ich auch am Telefon gebe.
            </p>
            <div class="reveal">
              <a href="/kontakt" class="link-arrow">
                Eigene Frage stellen
                <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="faq-list reveal">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-summary">
                  <span>{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </span>
                </summary>
                <div class="faq-body"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
