---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';
import DecoShapes from '../../components/DecoShapes.astro';

/** Was am Ende tatsächlich in der Hand liegt — keine abstrakten Versprechen. */
const deliverables = [
  {
    num: '01',
    title: 'Logo in allen Formaten',
    body: 'Ein Zeichen, das auf dem Firmenwagen genauso funktioniert wie in einer E-Mail-Signatur — und das auch bei 16 Pixeln noch erkennbar ist.',
    items: [
      'Vektordateien (SVG, PDF) für Druck und Beschriftung',
      'PNG in mehreren Größen für Web und Office',
      'Varianten für helle und dunkle Hintergründe',
      'Reduzierte Fassung für Favicon und Social-Media-Avatar',
    ],
  },
  {
    num: '02',
    title: 'Farben und Schriften',
    body: 'Ein System statt einer Sammlung. Festgelegt, wo welche Farbe hingehört und welche Schrift wofür — damit Entscheidungen später nicht jedes Mal neu getroffen werden müssen.',
    items: [
      'Farbpalette mit HEX-, RGB- und CMYK-Werten',
      'Eine Akzentfarbe mit klarer Rolle, nicht fünf gleichberechtigte',
      'Schriftpaarung für Überschrift, Text und Auszeichnung',
      'Lizenzhinweise — nur Schriften, die du auch nutzen darfst',
    ],
  },
  {
    num: '03',
    title: 'Vorlagen für den Alltag',
    body: 'Das, was täglich rausgeht. Ein Erscheinungsbild wird nicht im Handbuch sichtbar, sondern im Angebot, das der Kunde öffnet.',
    items: [
      'Angebots- und Rechnungsvorlage',
      'Briefpapier und Visitenkarte, druckfertig',
      'E-Mail-Signatur für dich und dein Team',
      'Social-Media-Vorlagen, falls du dort aktiv bist',
    ],
  },
  {
    num: '04',
    title: 'Kompaktes CI-Manual',
    body: 'Wenige Seiten statt sechzig. Genug, dass eine Druckerei oder ein Fahrzeugbeschrifter ohne Rückfragen arbeiten kann.',
    items: [
      'Logo-Verwendung mit Schutzraum und Mindestgröße',
      'Farb- und Schriftwerte zum Weitergeben',
      'Was erlaubt ist und was nicht — mit Beispielen',
      'Als PDF, zum Weiterschicken an Dritte',
    ],
  },
];

const faqs = [
  {
    q: 'Was ist der Unterschied zwischen Logo, Branding und Corporate Design?',
    a: 'Das Logo ist ein einzelnes Zeichen. Corporate Design ist das System darum herum: Farben, Schriften, Bildsprache und Vorlagen, damit alles zusammenpasst. Branding ist der weiteste Begriff und umfasst zusätzlich, wie du sprichst und wie du wahrgenommen wirst. Praktisch brauchen die meisten Betriebe genau das Mittlere — ein Logo allein löst das Problem nicht, weil die Rechnung danach trotzdem aussieht wie aus einem anderen Unternehmen.',
  },
  {
    q: 'Was kostet nur ein Logo, ohne den Rest?',
    a: 'Das geht und ist günstiger als das Paket. Die Zahl nenne ich im Erstgespräch, weil der Aufwand stark davon abhängt, ob du schon eine Vorstellung hast oder bei Null anfängst. Offen gesagt rate ich meist davon ab: Ein Logo ohne Farb- und Schriftsystem landet erfahrungsgemäß nach einem halben Jahr auf einer Website, die wieder anders aussieht — dann zahlst du zweimal.',
  },
  {
    q: 'Kann ich mein bestehendes Logo behalten?',
    a: 'Ja, oft ist das der richtige Weg. Wenn dein Logo eingeführt ist und deine Kunden es kennen, baue ich das System darum herum auf, statt es wegzuwerfen — Farben und Schriften darauf abgestimmt, Vorlagen neu, Logo bleibt. Manchmal reicht auch eine vorsichtige Überarbeitung, etwa saubere Vektordateien für ein Logo, das nur als verpixeltes JPG existiert.',
  },
  {
    q: 'Brauche ich ein CI-Manual, wenn wir nur drei Leute sind?',
    a: 'Für euch intern nicht wirklich. Der Nutzen liegt bei Dritten: Druckerei, Fahrzeugbeschrifter, Messebauer, der Praktikant, der die Social-Media-Posts macht. Ohne Vorgabe entscheidet jeder selbst, und nach zwei Jahren hast du vier Blautöne. Deshalb sind es bei mir wenige Seiten, keine sechzig — genug, dass niemand fragen muss.',
  },
  {
    q: 'Wie lange dauert es?',
    a: 'Zwei bis vier Wochen für das Paket. Der Löwenanteil ist Abstimmung, nicht Zeichnen: Du siehst Entwürfe, wir entscheiden, ich baue aus. Dein Aufwand liegt bei etwa drei Stunden verteilt über die Zeit.',
  },
  {
    q: 'Was, wenn mir kein Entwurf gefällt?',
    a: 'Dann war die Richtung falsch, und das ist mein Fehler, nicht deiner. Im Paket sind zwei Überarbeitungsrunden enthalten. Wenn wir danach immer noch nicht zusammenkommen, bekommst du die bisherigen Dateien und wir beenden es — ich behalte nur den Aufwand, der bis dahin angefallen ist, nicht den vollen Preis.',
  },
];

const canonical = 'https://www.mb-solutions.biz/leistungen/branding-corporate-design/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.mb-solutions.biz' },
        { '@type': 'ListItem', position: 2, name: 'Leistungen', item: 'https://www.mb-solutions.biz/leistungen' },
        { '@type': 'ListItem', position: 3, name: 'Branding & Corporate Design', item: canonical },
      ],
    },
    {
      '@type': 'Service',
      name: 'Corporate Design erstellen lassen',
      serviceType: 'Branding und Corporate Design',
      description:
        'Corporate Design für kleine Unternehmen und Handwerksbetriebe in Köln: Logo in allen Formaten, Farb- und Schriftsystem, Vorlagen für Angebote und Briefpapier, kompaktes CI-Manual. Festpreis ab 690 €.',
      provider: { '@id': 'https://www.mb-solutions.biz/#business' },
      areaServed: [
        { '@type': 'City', name: 'Köln' },
        { '@type': 'City', name: 'Leverkusen' },
        { '@type': 'City', name: 'Bergisch Gladbach' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Branding-Leistungen',
        itemListElement: deliverables.map((d) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: d.title },
        })),
      },
      offers: {
        '@type': 'Offer',
        price: '690',
        priceCurrency: 'EUR',
        description: 'Corporate Design, Festpreis ab 690 €',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<style>
  .page-hero { position: relative; padding: clamp(4rem, 9vh, 7rem) 0 clamp(3rem, 6vh, 5rem); }
  .crumb {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3);
    margin-bottom: 1.5rem; animation: fadeUp 500ms var(--ease-out) 40ms both;
  }
  .crumb a { color: var(--ink-3); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  .crumb span[aria-current] { color: var(--ink); }

  .page-h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.0;
    margin: 0 0 1.5rem; max-width: 19ch;
    animation: fadeUp 650ms var(--ease-out) 140ms both;
  }
  .page-h1 .accent { color: var(--accent); }
  .page-hero-sub {
    font-size: 1.125rem; color: var(--ink-2); line-height: 1.7;
    max-width: 52ch; margin: 0 0 2rem;
    animation: fadeUp 550ms var(--ease-out) 240ms both;
  }
  .page-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; animation: fadeUp 550ms var(--ease-out) 320ms both; }

  .sec-h2 {
    font-size: clamp(2rem, 4vw, 3rem); font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.05; margin: 1.25rem 0 1rem;
  }
  .sec-sub { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.7; margin: 0; }
  .sec-header { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); max-width: 44rem; }

  /* Ausgangslage (dunkel) */
  .problem { position: relative; background: var(--deep); color: var(--on-deep); }
  .problem-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem); align-items: start;
  }
  .problem-h2 {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem); font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.08; margin: 1.25rem 0 0; color: var(--on-deep);
  }
  .symptoms { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .symptoms li {
    display: grid; grid-template-columns: 22px 1fr; gap: 14px;
    padding: 14px 0; border-top: 1px solid var(--deep-line);
    font-size: 1rem; color: var(--on-deep-2); line-height: 1.6;
  }
  .symptoms li:last-child { border-bottom: 1px solid var(--deep-line); }
  .symptoms svg { color: var(--accent-deep); margin-top: 4px; flex-shrink: 0; }
  .problem-note { margin-top: 1.5rem; font-size: 1rem; color: var(--on-deep-2); line-height: 1.75; }
  .problem-note strong { color: var(--on-deep); font-weight: 600; }

  /* Lieferumfang */
  .deliv { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex; flex-direction: column;
  }
  .card-num { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; color: var(--ink-3); margin-bottom: 1.5rem; }
  .card-title { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 0.75rem; line-height: 1.2; }
  .card-body { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.7; margin: 0 0 1.5rem; }
  .card-list { list-style: none; margin: 0; padding: 1.25rem 0 0; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 9px; }
  .card-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 0.875rem; color: var(--ink-2); line-height: 1.55; }
  .card-list svg { color: var(--accent); flex-shrink: 0; margin-top: 4px; }

  /* Unterschied: Branding, das ankommt */
  .diff { background: var(--paper-dim); }
  .diff-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .diff-text { display: flex; flex-direction: column; gap: 1.125rem; }
  .diff-text p { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.75; max-width: 54ch; }
  .diff-text strong { color: var(--ink); font-weight: 600; }

  /* Diese Website als Beispiel */
  .proof { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: clamp(1.75rem, 3vw, 2.25rem); }
  .proof-label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; display: block;
  }
  .proof-rows { display: flex; flex-direction: column; }
  .proof-row { display: grid; grid-template-columns: 118px 1fr; gap: 1rem; padding: 12px 0; border-top: 1px solid var(--border); align-items: baseline; }
  .proof-rows .proof-row:first-child { border-top: none; padding-top: 0; }
  .proof-key { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .proof-val { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.6; }
  .proof-val strong { color: var(--ink); font-weight: 600; }
  .swatches { display: flex; gap: 6px; margin-top: 6px; }
  .swatch { width: 26px; height: 26px; border-radius: 4px; border: 1px solid var(--border); }

  /* Preis */
  .price-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .price-text { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.75; margin: 0 0 1.25rem; max-width: 46ch; }
  .price-card {
    background: var(--surface); border: 1.5px solid var(--accent);
    border-radius: var(--r-lg); padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex; flex-direction: column; gap: 1.25rem;
  }
  .price-top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .price-name { font-size: 1.1875rem; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
  .price-tag { font-family: var(--font-mono); font-size: 1.375rem; font-weight: 600; color: var(--accent-strong); white-space: nowrap; }
  .price-list { list-style: none; margin: 0; padding: 1.25rem 0 0; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px; }
  .price-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 0.9375rem; color: var(--ink-2); line-height: 1.55; }
  .price-list svg { color: var(--accent); flex-shrink: 0; margin-top: 5px; }
  .price-note { font-size: 0.875rem; color: var(--ink-3); line-height: 1.6; margin: 0; }

  /* FAQ */
  .faq-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .faq-h2 { font-size: clamp(1.75rem, 2.8vw, 2.25rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 1.25rem 0 1.25rem; }
  .faq-side { font-size: 1rem; color: var(--ink-2); line-height: 1.7; max-width: 34ch; margin: 0 0 1.75rem; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-item { border-top: 1px solid var(--border-2); }
  .faq-list .faq-item:last-child { border-bottom: 1px solid var(--border-2); }
  .faq-summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.25rem;
    padding: 1.375rem 4px; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600;
    color: var(--ink); letter-spacing: -0.015em; line-height: 1.35;
    transition: color 150ms var(--ease-out);
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary::marker { display: none; }
  @media (hover: hover) and (pointer: fine) { .faq-summary:hover { color: var(--accent-strong); } }
  .faq-icon { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--ink-3); transition: transform 260ms var(--ease-out), color 200ms var(--ease-out); }
  .faq-item[open] .faq-icon { transform: rotate(45deg); color: var(--accent); }
  .faq-body { padding: 0 4px 1.5rem; max-width: 62ch; }
  .faq-item[open] .faq-body { animation: fadeUp 260ms var(--ease-out) both; }
  .faq-body p { font-size: 0.9688rem; color: var(--ink-2); line-height: 1.75; margin: 0; }

  @media (max-width: 900px) { .deliv { grid-template-columns: 1fr; } }
  @media (max-width: 820px) {
    .problem-grid, .diff-grid, .price-grid, .faq-grid { grid-template-columns: 1fr; gap: 2rem; }
    .proof-row { grid-template-columns: 1fr; gap: 2px; }
  }
</style>

<BaseLayout
  title="Corporate Design erstellen lassen — Branding Köln"
  description="Corporate Design und Branding aus Köln: Logo in allen Formaten, Farb- und Schriftsystem, Vorlagen für Angebote und Briefpapier, kompaktes CI-Manual. Festpreis ab 690 €."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>

  <Navbar />
  <main id="main-content">

    <!-- Hero -->
    <section class="page-hero" aria-labelledby="br-heading">
      <DecoShapes variant="corner" />
      <div class="container-site">
        <nav class="crumb" aria-label="Brotkrumen-Navigation">
          <a href="/">Start</a>
          <span aria-hidden="true">/</span>
          <a href="/leistungen">Leistungen</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Branding &amp; Corporate Design</span>
        </nav>
        <h1 class="page-h1" id="br-heading">
          <span class="accent">Corporate Design</span> erstellen lassen — in Köln.
        </h1>
        <p class="page-hero-sub">
          Logo, Farben, Schriften und Vorlagen als ein System, das zusammenpasst.
          Damit dein Angebot, deine Visitenkarte und deine Website erkennbar
          zum selben Betrieb gehören. Festpreis ab 690 €.
        </p>
        <div class="page-hero-ctas">
          <a href="/kontakt" class="btn-primary">Kostenloses Erstgespräch</a>
          <a href="tel:+491718165966" class="btn-ghost">Direkt anrufen</a>
        </div>
      </div>
    </section>

    <!-- Ausgangslage -->
    <section class="problem section-pad on-deep" aria-labelledby="problem-heading">
      <DecoShapes variant="deep" />
      <div class="container-site">
        <div class="problem-grid">
          <div>
            <p class="label-mono">Ausgangslage</p>
            <h2 class="problem-h2" id="problem-heading">
              Drei Handschriften für einen Betrieb.
            </h2>
            <p class="problem-note">
              <strong>Das passiert nicht aus Nachlässigkeit,</strong> sondern weil
              alles einzeln entstanden ist: Das Logo hat vor Jahren ein Bekannter
              gemacht, die Visitenkarte kam vom Druckshop, die Rechnung aus
              Word, und die Website hat wieder jemand anderes gebaut.
            </p>
          </div>
          <ul class="symptoms" aria-label="Typische Situation">
            {[
              'Das Logo existiert nur als verpixeltes JPG, niemand hat die Originaldatei',
              'Auf der Visitenkarte ist das Blau anders als auf der Website',
              'Angebote kommen aus Word, in der Standardschrift',
              'Die Fahrzeugbeschriftung nutzt eine Schrift, die sonst nirgends vorkommt',
              'Jeder im Team hat eine eigene E-Mail-Signatur gebastelt',
              'Beim nächsten Druckauftrag wird wieder neu entschieden',
            ].map(s => (
              <li>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.6"/>
                  <path d="M10 6v5M10 13.5v.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                {s}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Lieferumfang -->
    <section class="section-pad" aria-labelledby="deliv-heading">
      <div class="container-site">
        <div class="sec-header">
          <p class="label-mono reveal">Lieferumfang</p>
          <h2 class="sec-h2 reveal" id="deliv-heading">Was am Ende in deiner Hand liegt.</h2>
          <p class="sec-sub reveal">
            Keine Moodboards und keine Markenwerte-Workshops. Vier Bausteine,
            die du sofort benutzen und an Dritte weitergeben kannst.
          </p>
        </div>
        <div class="deliv">
          {deliverables.map(d => (
            <article class="card reveal">
              <span class="card-num" aria-hidden="true">{d.num}</span>
              <h3 class="card-title">{d.title}</h3>
              <p class="card-body">{d.body}</p>
              <ul class="card-list">
                {d.items.map(i => (
                  <li>
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {i}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Der Unterschied + diese Website als Beleg -->
    <section class="diff section-pad" aria-labelledby="diff-heading">
      <div class="container-site">
        <div class="diff-grid">
          <div>
            <p class="label-mono reveal">Der Unterschied</p>
            <h2 class="sec-h2 reveal" id="diff-heading">Branding, das auf der Website ankommt.</h2>
            <div class="diff-text reveal">
              <p>
                Der häufigste Ausgang eines Branding-Projekts: Du bekommst ein
                PDF-Handbuch, die Agentur ist fertig, und ein halbes Jahr später
                baut jemand anderes die Website — <strong>und hält sich nicht
                daran, weil das Handbuch niemand liest.</strong>
              </p>
              <p>
                Bei mir fällt dieser Bruch weg, weil ich die Website auch baue.
                Das Farbsystem wird nicht beschrieben, sondern eingebaut. Die
                Schriften sind die, die auf der Seite laufen. Die E-Mail-Signatur
                passt zur Website, weil beides aus derselben Hand kommt.
              </p>
              <p>
                Das ist kein Verkaufsargument, das ich mir überlegt habe —
                es ist der Grund, warum ich Webdesign und Branding überhaupt
                zusammen anbiete.
              </p>
            </div>
          </div>
          <div class="proof reveal">
            <span class="proof-label">Beispiel: diese Website</span>
            <div class="proof-rows">
              <div class="proof-row">
                <span class="proof-key">Farben</span>
                <span class="proof-val">
                  <strong>Eine</strong> Akzentfarbe mit klarer Rolle, dazu ein dunkler Kontrast und ein Papierton — nicht fünf gleichberechtigte Töne.
                  <span class="swatches" aria-hidden="true">
                    <span class="swatch" style="background:#FAF8F4"></span>
                    <span class="swatch" style="background:#ECE9FB"></span>
                    <span class="swatch" style="background:#5B4FD1"></span>
                    <span class="swatch" style="background:#2A2260"></span>
                    <span class="swatch" style="background:#1E1B2E"></span>
                  </span>
                </span>
              </div>
              <div class="proof-row">
                <span class="proof-key">Schriften</span>
                <span class="proof-val">Drei Schriften mit festen Rollen: eine für Überschriften, eine für Text, eine für Labels und Zahlen. Selbst gehostet, keine Ladezeit von fremden Servern.</span>
              </div>
              <div class="proof-row">
                <span class="proof-key">System</span>
                <span class="proof-val">Alle Farben, Abstände und Radien liegen als benannte Werte an einer Stelle. Eine Änderung wirkt überall — statt an 40 Stellen nachgezogen zu werden.</span>
              </div>
              <div class="proof-row">
                <span class="proof-key">Bildsprache</span>
                <span class="proof-val">Eigene abstrakte Grafiken statt Stockfotos. Dieselben Illustrationen verwende ich für Verzeichnis- und Plattformprofile — ein Bildvorrat, kein Einzelfall.</span>
              </div>
              <div class="proof-row">
                <span class="proof-key">Nachprüfbar</span>
                <span class="proof-val">Du siehst es gerade. Kein Mockup, kein Konzept — die Seite ist das Ergebnis, und du kannst jedes Detail hier direkt beurteilen.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Preis -->
    <section class="section-pad" aria-labelledby="price-heading">
      <div class="container-site">
        <div class="price-grid">
          <div>
            <p class="label-mono reveal">Preis</p>
            <h2 class="sec-h2 reveal" id="price-heading">Festpreis, zwei Runden inklusive.</h2>
            <p class="price-text reveal">
              Kein Stundensatz und keine Überraschung am Ende. Zwei
              Überarbeitungsrunden sind eingerechnet — weil eine erste Fassung
              selten sofort sitzt und das normal ist.
            </p>
            <div class="reveal">
              <a href="/webdesign-kosten" class="link-arrow">
                Preise für Websites
                <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="price-card reveal">
            <div class="price-top">
              <h3 class="price-name">Corporate Design, komplett</h3>
              <span class="price-tag">ab 690 €</span>
            </div>
            <ul class="price-list">
              {[
                'Logo in allen Datei- und Farbvarianten',
                'Farbpalette und Schriftsystem, dokumentiert',
                'Angebots-, Rechnungs- und Briefvorlage',
                'Visitenkarte druckfertig',
                'E-Mail-Signaturen fürs Team',
                'Kompaktes CI-Manual als PDF',
                'Zwei Überarbeitungsrunden',
              ].map(item => (
                <li>
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {item}
                </li>
              ))}
            </ul>
            <p class="price-note">
              Richtwert für einen überschaubaren Betrieb. Nur ein Logo geht auch
              und ist günstiger — die Zahl nenne ich im Erstgespräch, weil der
              Aufwand stark davon abhängt, ob du schon eine Vorstellung hast.
              Zusammen mit einer Website wird beides günstiger als getrennt
              beauftragt.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="diff section-pad" aria-labelledby="faq-heading">
      <div class="container-site">
        <div class="faq-grid">
          <div>
            <p class="label-mono reveal">Häufige Fragen</p>
            <h2 class="faq-h2 reveal" id="faq-heading">Fragen zu Branding.</h2>
            <p class="faq-side reveal">
              Inklusive der Frage, wann ein Logo allein die schlechtere
              Entscheidung ist — auch wenn es weniger kostet.
            </p>
            <div class="reveal">
              <a href="/kontakt" class="link-arrow">
                Eigene Frage stellen
                <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="faq-list reveal">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-summary">
                  <span>{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </span>
                </summary>
                <div class="faq-body"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
