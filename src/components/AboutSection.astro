---
const compare = [
  { label: 'Ansprechpartner',  agency: 'Wechselnd, je nach Projektphase', me: 'Immer ich — vom ersten Gespräch bis zum Support' },
  { label: 'Kommunikation',    agency: 'Über Projektleiter und Tickets',  me: 'Direkt: Anruf, WhatsApp oder E-Mail' },
  { label: 'Preis',            agency: 'Stundensätze plus Overhead',      me: 'Festpreis vor Projektstart' },
  { label: 'Nach dem Launch',  agency: 'Supportcenter',                   me: 'Kurzer Draht zu dem, der die Seite gebaut hat' },
];
---

<style>
  .about { background: var(--paper-dim); }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .about-h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.04; margin: 1.25rem 0 1.5rem;
  }
  .about-p {
    font-size: 1.0625rem; color: var(--ink-2);
    line-height: 1.75; max-width: 50ch; margin: 0 0 1.25rem;
  }

  /* Vergleich Agentur vs. direkt */
  .compare { border-top: 1px solid var(--border-2); }
  .compare-head {
    display: grid; grid-template-columns: 110px 1fr 1fr; gap: 1.25rem;
    padding: 12px 0 10px;
    border-bottom: 1px solid var(--border);
  }
  .compare-head span {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3);
  }
  .compare-head span:last-child { color: var(--accent); }

  .compare-row {
    display: grid; grid-template-columns: 110px 1fr 1fr; gap: 1.25rem;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem; line-height: 1.55;
  }
  .compare-label {
    font-family: var(--font-display); font-weight: 600;
    font-size: 0.875rem; color: var(--ink); letter-spacing: -0.01em;
  }
  .compare-agency { color: var(--ink-3); }
  .compare-me { color: var(--ink); font-weight: 500; }

  .about-link-row { margin-top: 1.75rem; }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .compare-head, .compare-row { grid-template-columns: 1fr; gap: 4px; }
    .compare-head { display: none; }
    .compare-row { padding: 16px 0; }
    .compare-agency { text-decoration: line-through; text-decoration-color: rgba(30,27,46,0.25); }
  }
</style>

<section class="about section-pad" aria-labelledby="about-heading">
  <div class="container-site">
    <div class="about-grid">
      <div>
        <p class="label-mono reveal">Über mich</p>
        <h2 class="about-h2 reveal" id="about-heading">
          Du sprichst mit dem, der es baut.
        </h2>
        <p class="about-p reveal">
          Ich bin Maurice Bourkiah — Webdesigner, Entwickler und IT-Berater
          aus Köln. Ich arbeite direkt mit meinen Kunden: keine
          Unterauftragnehmer, keine langen Kommunikationsketten.
        </p>
        <p class="about-p reveal">
          Handwerksbetriebe und kleine Unternehmen verdienen denselben
          professionellen Auftritt wie große Konzerne — ohne die großen
          Agentur-Budgets dafür zu brauchen.
        </p>
        <div class="about-link-row reveal">
          <a href="/ueber-mich" class="link-arrow">
            Mehr über mich
            <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="compare reveal" role="table" aria-label="Vergleich: klassische Agentur und MB-Solutions">
        <div class="compare-head" role="row">
          <span></span>
          <span role="columnheader">Klassische Agentur</span>
          <span role="columnheader">Mit mir</span>
        </div>
        {compare.map(row => (
          <div class="compare-row" role="row">
            <span class="compare-label" role="rowheader">{row.label}</span>
            <span class="compare-agency" role="cell">{row.agency}</span>
            <span class="compare-me" role="cell">{row.me}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
