---
const services = [
  {
    title: 'Webdesign & Entwicklung',
    desc: 'Eine Website, die Anfragen bringt — nicht nur gut aussieht. Von der ersten Skizze bis zum Live-Gang.',
    benefits: [
      'Auf dem Handy genauso gut bedienbar wie am PC',
      'Bei Google findbar — lokales SEO inklusive',
      'Inhalte selbst ändern oder ändern lassen',
    ],
    href: '/leistungen#webdesign',
  },
  {
    title: 'IT-Services & Cloud',
    desc: 'Deine Technik läuft, du kümmerst dich um dein Geschäft. Einrichtung und laufende Betreuung.',
    benefits: [
      'Professionelle E-Mail-Adressen mit eigener Domain',
      'Automatische Backups deiner Daten',
      'Ein Anruf genügt, wenn etwas klemmt',
    ],
    href: '/leistungen#it-services',
  },
  {
    title: 'Branding & Corporate Identity',
    desc: 'Ein Auftritt, den deine Kunden wiedererkennen — vom Logo bis zur Fahrzeugbeschriftung.',
    benefits: [
      'Logo, Farben und Schriften, die zum Betrieb passen',
      'Vorlagen für Angebote, Visitenkarten & Co.',
      'Dokumentiert, damit alles überall gleich aussieht',
    ],
    href: '/leistungen#branding',
  },
];
---

<style>
  .services-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 2rem; flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .services-h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.04; margin: 0;
    max-width: 15ch;
  }
  .services-sub {
    font-size: 1.0625rem; color: var(--ink-2);
    line-height: 1.7; max-width: 36ch; margin: 0;
  }

  /* Liegende Bänder statt drei gleicher Karten */
  .services-list { display: flex; flex-direction: column; }

  .service-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    padding: clamp(1.75rem, 3.5vw, 2.75rem) 4px;
    text-decoration: none; color: inherit;
    transition: padding-left 220ms var(--ease-out);
  }
  /* Trennlinie als eigenes Element, damit sie sich zeichnen kann */
  .service-row::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: var(--border-2);
    transform-origin: left center;
  }
  .services-list .service-row:last-child { border-bottom: 1px solid var(--border-2); }
  @media (hover: hover) and (pointer: fine) {
    .service-row:hover { padding-left: 14px; }
    .service-row:hover .service-title { color: var(--accent-strong); }
    .service-row:hover .service-more svg { transform: translateX(4px); }
  }

  /*
   * Die Linie zeichnet sich, während das Band in den Blick scrollt. Bewegung,
   * die die Struktur erklärt statt nur zu dekorieren — und der Inhalt selbst
   * bleibt ruhig, damit pro Band nur eine Sache passiert.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .service-row::before {
        animation: serviceRuleIn linear both;
        animation-timeline: view();
        animation-range: entry 8% entry 42%;
      }
    }
  }
  @keyframes serviceRuleIn {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .service-title {
    font-size: clamp(1.375rem, 2.6vw, 1.875rem); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.12; margin: 0 0 0.75rem;
    transition: color 180ms var(--ease-out);
  }
  .service-desc {
    font-size: 1rem; color: var(--ink-2); line-height: 1.7;
    margin: 0 0 1.25rem; max-width: 40ch;
  }

  .service-benefits {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 11px;
  }
  .service-benefits li {
    display: grid; grid-template-columns: 14px 1fr; gap: 12px;
    font-size: 0.9375rem; color: var(--ink-2); line-height: 1.6;
  }
  .service-benefits svg { color: var(--accent); margin-top: 6px; }

  .service-more {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-display); font-size: 15px; font-weight: 600;
    color: var(--accent); letter-spacing: -0.01em;
  }
  .service-more svg { transition: transform 200ms var(--ease-out); flex-shrink: 0; }

  /* Einstiege für konkrete Zielgruppen */
  .services-entries {
    display: flex; flex-wrap: wrap; gap: 1.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (max-width: 820px) {
    .service-row { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>

<section class="section-pad" aria-labelledby="services-heading" id="leistungen">
  <div class="container-site">
    <div class="services-header">
      <h2 class="services-h2 reveal" id="services-heading">
        Drei Bereiche, ein Ansprechpartner.
      </h2>
      <p class="services-sub reveal">
        Web, IT und Marke greifen ineinander — deshalb bekommst du
        alles aus einer Hand, ohne Schnittstellen.
      </p>
    </div>

    <div class="services-list">
      {services.map(s => (
        <a href={s.href} class="service-row">
          <div>
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
            <span class="service-more">
              Mehr zu {s.title.split(' ')[0]}
              <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
          <ul class="service-benefits">
            {s.benefits.map(b => (
              <li>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {b}
              </li>
            ))}
          </ul>
        </a>
      ))}
    </div>

    <div class="services-entries reveal">
      <a href="/leistungen/webdesign-handwerker" class="link-arrow">
        Webdesign für Handwerker
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/leistungen/it-service-koeln" class="link-arrow">
        IT-Service Köln
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/leistungen/branding-corporate-design" class="link-arrow">
        Corporate Design
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/webdesign-kosten" class="link-arrow">
        Was kostet eine Website?
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
