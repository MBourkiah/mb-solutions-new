---
const services = [
  {
    num: '01',
    title: 'Webdesign & Entwicklung',
    desc: 'Eine Website, die Anfragen bringt — nicht nur gut aussieht. Von der ersten Skizze bis zum Live-Gang.',
    benefits: [
      'Auf dem Handy genauso gut bedienbar wie am PC',
      'Bei Google findbar — lokales SEO inklusive',
      'Inhalte selbst ändern oder ändern lassen',
    ],
    href: '/leistungen#webdesign',
  },
  {
    num: '02',
    title: 'IT-Services & Cloud',
    desc: 'Deine Technik läuft, du kümmerst dich um dein Geschäft. Einrichtung und laufende Betreuung.',
    benefits: [
      'Professionelle E-Mail-Adressen mit eigener Domain',
      'Automatische Backups deiner Daten',
      'Ein Anruf genügt, wenn etwas klemmt',
    ],
    href: '/leistungen#it-services',
  },
  {
    num: '03',
    title: 'Branding & Corporate Identity',
    desc: 'Ein Auftritt, den deine Kunden wiedererkennen — vom Logo bis zur Fahrzeugbeschriftung.',
    benefits: [
      'Logo, Farben und Schriften, die zum Betrieb passen',
      'Vorlagen für Angebote, Visitenkarten & Co.',
      'Dokumentiert, damit alles überall gleich aussieht',
    ],
    href: '/leistungen#branding',
  },
];
---

<style>
  .services-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 2rem; flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .services-h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.04; margin: 1.25rem 0 0;
    max-width: 15ch;
  }
  .services-sub {
    font-size: 1.0625rem; color: var(--ink-2);
    line-height: 1.7; max-width: 36ch; margin: 0;
  }

  .services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .service-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex; flex-direction: column;
    text-decoration: none; color: inherit;
    transition: border-color 220ms var(--ease-out), transform 220ms var(--ease-out),
                box-shadow 220ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      border-color: var(--tint-border);
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
    }
    .service-card:hover .service-more svg { transform: translateX(4px); }
  }

  .service-num {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.12em; color: var(--ink-3);
    margin-bottom: 2.25rem;
  }
  .service-title {
    font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em;
    line-height: 1.15; margin: 0 0 0.75rem;
  }
  .service-desc {
    font-size: 0.9375rem; color: var(--ink-2); line-height: 1.65;
    margin: 0 0 1.75rem;
  }

  .service-benefits {
    list-style: none; padding: 1.375rem 0 0; margin: 0 0 1.75rem;
    border-top: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 10px;
    flex: 1;
  }
  .service-benefits li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 0.875rem; color: var(--ink-2); line-height: 1.55;
  }
  .service-benefits svg { color: var(--accent); flex-shrink: 0; margin-top: 4px; }

  .service-more {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-display); font-size: 14px; font-weight: 600;
    color: var(--accent); letter-spacing: -0.01em;
    margin-top: auto;
  }
  .service-more svg { transition: transform 200ms var(--ease-out); flex-shrink: 0; }

  /* Einstiege für konkrete Zielgruppen unter dem Raster */
  .services-entries {
    display: flex; flex-wrap: wrap; gap: 1.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: 1.5rem; border-top: 1px solid var(--border);
  }
  .services-entries-label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3);
    align-self: center;
  }

  @media (max-width: 980px) { .services-grid { grid-template-columns: 1fr; } }
  @media (min-width: 640px) and (max-width: 980px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .service-card:last-child { grid-column: span 2; }
  }
</style>

<section class="section-pad" aria-labelledby="services-heading" id="leistungen">
  <div class="container-site">
    <div class="services-header">
      <div>
        <p class="label-mono reveal">Leistungen</p>
        <h2 class="services-h2 reveal" id="services-heading">
          Drei Bereiche, ein Ansprechpartner.
        </h2>
      </div>
      <p class="services-sub reveal">
        Web, IT und Marke greifen ineinander — deshalb bekommst du
        alles aus einer Hand, ohne Schnittstellen.
      </p>
    </div>

    <div class="services-grid">
      {services.map(s => (
        <a href={s.href} class="service-card reveal">
          <span class="service-num" aria-hidden="true">{s.num}</span>
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.desc}</p>
          <ul class="service-benefits">
            {s.benefits.map(b => (
              <li>
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {b}
              </li>
            ))}
          </ul>
          <span class="service-more">
            Mehr zu {s.title.split(' ')[0]}
            <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      ))}
    </div>

    <div class="services-entries reveal">
      <span class="services-entries-label">Direkt zum Thema</span>
      <a href="/leistungen/webdesign-handwerker" class="link-arrow">
        Webdesign für Handwerker
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/leistungen/it-service-koeln" class="link-arrow">
        IT-Service Köln
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/webdesign-kosten" class="link-arrow">
        Was kostet eine Website?
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
