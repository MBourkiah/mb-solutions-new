---
/**
 * Slot für ein echtes Foto (Headshot oder Workspace).
 *
 * - Liegt `src/assets/real/maurice.{jpg,jpeg,png,webp}` vor, wird das Foto
 *   optimiert ausgeliefert — auf Wunsch mit Duotone-Behandlung in
 *   Tiefviolett, damit es zur Bildsprache passt.
 * - Fehlt die Datei, erscheint ein gestalteter Platzhalter (Monogramm +
 *   Schnittmarken), der offensichtlich sagt: hier kommt noch ein Foto hin.
 *   Kein Stock-Bild.
 *
 * Foto liefern: Hochformat 4:5, mind. 1000×1250 px → src/assets/real/maurice.jpg
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  alt?: string;
  duotone?: boolean;
}
const {
  alt = 'Maurice Bourkiah, MB-Solutions Köln',
  duotone = true,
} = Astro.props;

const realImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/real/maurice.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photo = Object.values(realImages)[0]?.default;
---

<style>
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  /* Echtes Foto */
  .portrait.has-photo { border-color: var(--deep); }
  .portrait.has-photo.duotone { background: var(--deep); }
  .portrait :global(img),
  .portrait :global(picture) {
    display: block; width: 100%; height: 100%;
    object-fit: cover;
  }
  .portrait.duotone :global(img) {
    filter: grayscale(1) contrast(1.06);
    mix-blend-mode: luminosity;
  }
  .portrait.duotone::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(91,79,209,0.16), rgba(42,34,96,0.18));
    pointer-events: none;
  }

  /* Gestalteter Platzhalter-Zustand */
  .portrait.is-placeholder {
    background: var(--tint);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 12px;
  }
  .portrait-monogram {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 5.5rem);
    font-weight: 800; letter-spacing: -0.04em; line-height: 1;
    color: var(--accent);
  }
  .portrait-note {
    font-family: var(--font-mono);
    font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-2); text-align: center;
    max-width: 22ch; line-height: 1.7;
  }
  /* Schnittmarken in den Ecken */
  .crop-mark {
    position: absolute; width: 18px; height: 18px;
    border-color: var(--accent); border-style: solid; border-width: 0;
  }
  .crop-mark.tl { top: 12px; left: 12px; border-top-width: 2px; border-left-width: 2px; }
  .crop-mark.tr { top: 12px; right: 12px; border-top-width: 2px; border-right-width: 2px; }
  .crop-mark.bl { bottom: 12px; left: 12px; border-bottom-width: 2px; border-left-width: 2px; }
  .crop-mark.br { bottom: 12px; right: 12px; border-bottom-width: 2px; border-right-width: 2px; }
</style>

{photo ? (
  <div class={`portrait has-photo ${duotone ? 'duotone' : ''}`}>
    <Picture
      src={photo}
      formats={['avif', 'webp']}
      widths={[400, 640, 900]}
      sizes="(max-width: 820px) 80vw, 400px"
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </div>
) : (
  <div class="portrait is-placeholder" role="img" aria-label="Platzhalter — hier folgt ein Foto von Maurice Bourkiah">
    <span class="crop-mark tl" aria-hidden="true"></span>
    <span class="crop-mark tr" aria-hidden="true"></span>
    <span class="crop-mark bl" aria-hidden="true"></span>
    <span class="crop-mark br" aria-hidden="true"></span>
    <span class="portrait-monogram" aria-hidden="true">MB</span>
    <span class="portrait-note">Hier folgt ein echtes Foto — kein Stock-Bild</span>
  </div>
)}
