---
/**
 * Rein dekorative Formen in der Sprache der Konzept-Illustrationen
 * (gleiche Linienstärke 2–2.5, gleiche Palette, Offset-Print-Motiv).
 * Keine Tatsachenbehauptung — nur Gestaltung. Inline-SVG, null Requests.
 *
 * Varianten:
 * - 'hero'   großzügige Komposition für den Startseiten-Hero (oben rechts)
 * - 'corner' leiser Eck-Akzent für Seiten-Heros der Unterseiten
 * - 'deep'   helle Konturen für dunkle (Tiefviolett-)Sections
 *
 * Eltern-Element braucht position: relative; Inhalt liegt via
 * .container-site (z-index 1) über den Formen.
 */
interface Props {
  variant: 'hero' | 'corner' | 'deep';
  /** horizontal spiegeln, z. B. um zwei dunkle Sections zu variieren */
  flip?: boolean;
}
const { variant, flip = false } = Astro.props;

const deep = '#2A2260';
const accent = '#5B4FD1';
const tint = '#ECE9FB';
---

<style>
  .deco {
    position: absolute; inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .deco.flip { transform: scaleX(-1); }
  .deco svg { position: absolute; }

  .deco-hero svg {
    top: 0; right: -50px;
    width: min(640px, 52vw); height: auto;
    mask-image: linear-gradient(215deg, black 52%, transparent 86%);
    -webkit-mask-image: linear-gradient(215deg, black 52%, transparent 86%);
  }
  @media (max-width: 900px) { .deco-hero svg { opacity: 0.55; } }
  @media (max-width: 700px) { .deco-hero { display: none; } }

  .deco-corner svg {
    top: 24px; right: -30px;
    width: min(300px, 30vw); height: auto;
  }
  @media (max-width: 640px) { .deco-corner { display: none; } }

  .deco-deep svg {
    top: -60px; right: -40px;
    width: min(460px, 42vw); height: auto;
  }
  @media (max-width: 640px) { .deco-deep svg { opacity: 0.6; } }
</style>

<div class={`deco deco-${variant} ${flip ? 'flip' : ''}`} aria-hidden="true">

  {variant === 'hero' && (
    <svg viewBox="0 0 640 560" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="deco-dots" width="26" height="26" patternUnits="userSpaceOnUse">
          <circle cx="1.5" cy="1.5" r="1.5" fill={deep} opacity="0.16"/>
        </pattern>
      </defs>
      <rect x="252" y="26" width="330" height="240" fill="url(#deco-dots)"/>
      <circle cx="462" cy="232" r="115" fill={tint}/>
      <circle cx="480" cy="250" r="115" stroke={deep} stroke-width="2" opacity="0.65"/>
      <circle cx="322" cy="128" r="12" fill={accent}/>
      <rect x="492" y="392" width="46" height="46" rx="9" transform="rotate(12 515 415)" stroke={accent} stroke-width="2"/>
      <path d="M240 330h22M251 319v22" stroke={deep} stroke-width="2" stroke-linecap="round"/>
      <path d="M548 76h22M559 65v22" stroke={deep} stroke-width="2" stroke-linecap="round"/>
      <circle cx="266" cy="452" r="5" fill={accent} opacity="0.55"/>
      <circle cx="290" cy="452" r="5" fill={accent} opacity="0.3"/>
    </svg>
  )}

  {variant === 'corner' && (
    <svg viewBox="0 0 320 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="206" cy="112" r="70" fill={tint}/>
      <circle cx="219" cy="125" r="70" stroke={deep} stroke-width="2" opacity="0.55"/>
      <path d="M84 58h20M94 48v20" stroke={deep} stroke-width="2" stroke-linecap="round"/>
      <circle cx="112" cy="202" r="8" fill={accent}/>
    </svg>
  )}

  {variant === 'deep' && (
    <svg viewBox="0 0 480 420" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="330" cy="128" r="168" stroke="rgba(245,243,252,0.12)" stroke-width="2"/>
      <circle cx="306" cy="104" r="168" stroke="rgba(169,158,245,0.16)" stroke-width="2"/>
      <path d="M96 306h20M106 296v20" stroke="rgba(245,243,252,0.3)" stroke-width="2" stroke-linecap="round"/>
      <path d="M420 330h20M430 320v20" stroke="rgba(245,243,252,0.3)" stroke-width="2" stroke-linecap="round"/>
      <circle cx="152" cy="120" r="8" fill="rgba(169,158,245,0.5)"/>
    </svg>
  )}

</div>
