---
---

<style>
  .cf-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: clamp(1.75rem, 3vw, 2.5rem);
  }
  .cf-title {
    font-family: var(--font-display); font-size: 1.25rem; font-weight: 700;
    letter-spacing: -0.02em; color: var(--ink); margin-bottom: 0.375rem;
  }
  .cf-sub { font-size: 0.875rem; color: var(--ink-2); line-height: 1.6; margin-bottom: 2rem; }

  .cf-form { display: flex; flex-direction: column; gap: 14px; }
  .cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .cf-field { display: flex; flex-direction: column; gap: 6px; }
  .cf-label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    color: var(--ink-2); letter-spacing: 0.1em; text-transform: uppercase;
  }

  .cf-input, .cf-textarea, .cf-select {
    width: 100%; background: var(--paper); border: 1.5px solid var(--border-2);
    border-radius: var(--r-md); padding: 12px 14px;
    font-size: 0.9375rem; color: var(--ink); font-family: var(--font-body);
    transition: border-color 150ms var(--ease-out), box-shadow 150ms var(--ease-out);
    outline: none; -webkit-appearance: none;
  }
  .cf-input::placeholder, .cf-textarea::placeholder { color: var(--ink-3); }
  .cf-input:focus, .cf-textarea:focus, .cf-select:focus {
    border-color: var(--accent); box-shadow: 0 0 0 3px rgba(91,79,209,0.14);
  }
  .cf-textarea { resize: vertical; min-height: 130px; line-height: 1.65; }
  .cf-select { cursor: pointer; }
  .cf-submit { width: 100%; margin-top: 6px; }

  .cf-success { display: none; flex-direction: column; align-items: center; gap: 10px; text-align: center; padding: 2rem 1rem; }
  .cf-success.visible { display: flex; }
  .cf-success-icon {
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--tint);
    display: flex; align-items: center; justify-content: center;
  }
  .cf-success-title { font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--ink); }
  .cf-success-sub { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.6; max-width: 36ch; }

  @media (max-width: 500px) {
    .cf-row { grid-template-columns: 1fr; }
  }
</style>

<div class="cf-card">
  <div class="cf-title">Schreib mir eine Nachricht</div>
  <div class="cf-sub">Du bekommst innerhalb von 48 Stunden eine Antwort.</div>

  <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate aria-label="Kontaktformular" class="cf-form">
    <input type="hidden" name="access_key" value="bb35103f-8376-463d-ac6e-f98f06367d68" />
    <input type="hidden" name="subject" value="Neue Anfrage über mb-solutions.biz" />
    <input type="hidden" name="from_name" value="MB-Solutions Website" />
    <input type="checkbox" name="botcheck" style="display:none;" tabindex="-1" autocomplete="off" />
    <div class="cf-row">
      <div class="cf-field">
        <label class="cf-label" for="cf-name">Name *</label>
        <input type="text" id="cf-name" name="name" class="cf-input" placeholder="Max Mustermann" required autocomplete="name" />
      </div>
      <div class="cf-field">
        <label class="cf-label" for="cf-email">E-Mail *</label>
        <input type="email" id="cf-email" name="email" class="cf-input" placeholder="max@firma.de" required autocomplete="email" />
      </div>
    </div>
    <div class="cf-field">
      <label class="cf-label" for="cf-service">Ich interessiere mich für</label>
      <select id="cf-service" name="service" class="cf-select">
        <option value="">— Bitte auswählen —</option>
        <option value="webdesign">Webdesign &amp; Entwicklung</option>
        <option value="it-services">IT-Services &amp; Cloud-Setup</option>
        <option value="branding">Branding &amp; Corporate Identity</option>
        <option value="beratung">Allgemeine Beratung</option>
      </select>
    </div>
    <div class="cf-field">
      <label class="cf-label" for="cf-message">Nachricht *</label>
      <textarea id="cf-message" name="message" class="cf-textarea" placeholder="Beschreib kurz, was du brauchst — Stichpunkte reichen." required></textarea>
    </div>
    <button type="submit" class="btn-primary cf-submit">Nachricht senden</button>
  </form>

  <div id="cf-success" class="cf-success" aria-live="polite" role="status">
    <div class="cf-success-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="var(--accent-strong)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 11.08V12a9 9 0 1 1-5.34-8.23"/><path d="M20 4L11 13l-2.5-2.5"/>
      </svg>
    </div>
    <div class="cf-success-title">Nachricht gesendet</div>
    <div class="cf-success-sub">Vielen Dank. Ich melde mich innerhalb von 48 Stunden bei dir.</div>
  </div>
</div>

<script>
  const form    = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('cf-success');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Wird gesendet…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (res.ok) { form.style.display = 'none'; success?.classList.add('visible'); }
      else { btn.disabled = false; btn.textContent = 'Erneut versuchen'; }
    } catch { btn.disabled = false; btn.textContent = 'Erneut versuchen'; }
  });
</script>
