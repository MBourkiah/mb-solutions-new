---
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/leistungen', label: 'Leistungen' },
  { href: '/portfolio',  label: 'Arbeiten' },
  { href: '/ueber-mich', label: 'Über mich' },
  { href: '/kontakt',    label: 'Kontakt' },
];
---

<style>
  .nav-wrap {
    position: sticky; top: 0; z-index: 100;
    background: rgba(250,248,244,0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 220ms var(--ease-out);
  }
  .nav-wrap.scrolled { border-bottom-color: var(--border); }

  .nav-bar {
    max-width: 74rem; margin-inline: auto;
    padding: 18px clamp(1.25rem, 5vw, 2.5rem);
    display: flex; align-items: center; justify-content: space-between;
    gap: 2rem;
  }

  /* Logo */
  .logo {
    display: flex; align-items: center;
    text-decoration: none; flex-shrink: 0;
  }
  .logo img { display: block; height: 26px; width: auto; }

  /* Links */
  .nav-links { display: flex; align-items: center; gap: 26px; }
  .nav-link {
    position: relative;
    font-size: 14.5px; font-weight: 500; color: var(--ink-2);
    text-decoration: none; padding: 4px 0;
    transition: color 140ms var(--ease-out);
  }
  .nav-link::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: -2px;
    height: 2px; background: var(--accent);
    transform: scaleX(0); transform-origin: left center;
    transition: transform 200ms var(--ease-out);
  }
  .nav-link.active { color: var(--ink); }
  .nav-link.active::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover { color: var(--ink); }
    .nav-link:not(.active):hover::after { transform: scaleX(0.4); }
  }

  /* CTA */
  .nav-cta {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--ink); color: var(--paper);
    padding: 10px 20px; border-radius: var(--r-md);
    font-family: var(--font-display);
    font-size: 14px; font-weight: 600; text-decoration: none;
    letter-spacing: -0.01em;
    transition: background 160ms var(--ease-out), transform 160ms var(--ease-out);
    flex-shrink: 0;
  }
  .nav-cta:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .nav-cta:hover { background: var(--accent); }
  }

  /* Hamburger */
  .menu-btn {
    display: none; flex-direction: column; justify-content: center;
    align-items: flex-end; gap: 6px; width: 40px; height: 40px;
    background: transparent; border: none; padding: 0 2px;
  }
  .menu-btn span {
    display: block; height: 2px; background: var(--ink);
    border-radius: 1px;
  }

  /* Mobile overlay — Tiefviolett */
  .mobile-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: var(--deep);
    display: flex; flex-direction: column;
    padding: 24px clamp(1.5rem, 6vw, 3rem) 48px;
    opacity: 0; pointer-events: none;
    transition: opacity 260ms var(--ease-out);
  }
  .mobile-overlay.open { opacity: 1; pointer-events: all; }

  .mobile-top {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: auto;
  }
  .mobile-logo { display: flex; align-items: center; text-decoration: none; }
  .mobile-logo img { display: block; height: 24px; width: auto; }
  .mobile-close {
    width: 44px; height: 44px; background: none;
    border: 1px solid var(--deep-line); border-radius: var(--r-md);
    display: flex; align-items: center; justify-content: center;
    color: var(--on-deep-2);
  }

  .mobile-nav { display: flex; flex-direction: column; margin-bottom: auto; }
  .mobile-link {
    display: flex; align-items: baseline; gap: 16px;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 9vw, 3rem); font-weight: 700; letter-spacing: -0.02em;
    color: var(--on-deep); text-decoration: none;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--deep-line);
    opacity: 0; transform: translateY(14px);
    transition: opacity 320ms var(--ease-out), transform 320ms var(--ease-out),
                color 140ms var(--ease-out);
  }
  .mobile-link-num {
    font-family: var(--font-mono);
    font-size: 12px; font-weight: 500; letter-spacing: 0.1em;
    color: var(--on-deep-3);
  }
  .mobile-link.active { color: var(--accent-deep); }
  .mobile-overlay.open .mobile-link { opacity: 1; transform: translateY(0); }
  .mobile-overlay.open .mobile-link:nth-child(1) { transition-delay: 80ms; }
  .mobile-overlay.open .mobile-link:nth-child(2) { transition-delay: 140ms; }
  .mobile-overlay.open .mobile-link:nth-child(3) { transition-delay: 200ms; }
  .mobile-overlay.open .mobile-link:nth-child(4) { transition-delay: 260ms; }
  @media (hover: hover) and (pointer: fine) {
    .mobile-link:hover { color: var(--accent-deep); }
  }

  .mobile-foot {
    display: flex; flex-direction: column; gap: 18px;
    opacity: 0; transition: opacity 320ms var(--ease-out) 320ms;
  }
  .mobile-overlay.open .mobile-foot { opacity: 1; }
  .mobile-foot-contact {
    display: flex; flex-direction: column; gap: 4px;
    font-size: 14px;
  }
  .mobile-foot-contact a { color: var(--on-deep-2); text-decoration: none; }

  @media (max-width: 820px) {
    .nav-links, .nav-cta { display: none; }
    .menu-btn { display: flex; }
  }
</style>

<div class="nav-wrap" id="nav-wrap">
  <header class="nav-bar">
    <a href="/" class="logo" aria-label="MB-Solutions – Startseite">
      <img src="/logos/mb-logo-horizontal-violett.png" alt="MB-Solutions" width="130" height="26" />
    </a>

    <nav class="nav-links" aria-label="Hauptnavigation">
      {links.map(l => (
        <a
          href={l.href}
          class={`nav-link ${isActive(l.href) ? 'active' : ''}`}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >{l.label}</a>
      ))}
    </nav>

    <div style="display:flex;align-items:center;gap:8px;">
      <a href="/kontakt" class="nav-cta">Kostenloses Erstgespräch</a>
      <button id="menu-btn" class="menu-btn" aria-label="Menü öffnen" aria-expanded="false">
        <span style="width:24px;"></span>
        <span style="width:16px;"></span>
      </button>
    </div>
  </header>
</div>

<div id="mobile-overlay" class="mobile-overlay" aria-hidden="true" role="dialog" aria-label="Navigation">
  <div class="mobile-top">
    <a href="/" class="mobile-logo" aria-label="MB-Solutions – Startseite">
      <img src="/logos/mb-logo-horizontal-papier.png" alt="MB-Solutions" width="120" height="24" />
    </a>
    <button id="mobile-close" class="mobile-close" aria-label="Menü schließen">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
        <path d="M15 5L5 15M5 5l10 10"/>
      </svg>
    </button>
  </div>

  <nav class="mobile-nav" aria-label="Mobile Navigation">
    {links.map((l, i) => (
      <a href={l.href} class={`mobile-link ${isActive(l.href) ? 'active' : ''}`}>
        <span class="mobile-link-num" aria-hidden="true">0{i + 1}</span>
        {l.label}
      </a>
    ))}
  </nav>

  <div class="mobile-foot">
    <a href="/kontakt" class="btn-light" style="align-self:flex-start;">Kostenloses Erstgespräch</a>
    <div class="mobile-foot-contact">
      <a href="tel:+491718165966">+49 171 816 59 66</a>
      <a href="mailto:mbourkiah@mb-solutions.biz">mbourkiah@mb-solutions.biz</a>
    </div>
  </div>
</div>

<script>
  const wrap    = document.getElementById('nav-wrap');
  const btn     = document.getElementById('menu-btn');
  const overlay = document.getElementById('mobile-overlay');
  const closeBtn= document.getElementById('mobile-close');

  window.addEventListener('scroll', () => {
    wrap?.classList.toggle('scrolled', window.scrollY > 24);
  }, { passive: true });

  btn?.addEventListener('click', () => {
    overlay?.classList.add('open');
    overlay?.setAttribute('aria-hidden', 'false');
    btn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  });
  const close = () => {
    overlay?.classList.remove('open');
    overlay?.setAttribute('aria-hidden', 'true');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };
  closeBtn?.addEventListener('click', close);
  overlay?.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
</script>
