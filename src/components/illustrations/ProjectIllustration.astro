---
/**
 * Abstrakte Konzept-Illustrationen im Corporate Design.
 * Bewusst als Gestaltung erkennbar — kein vorgetäuschter Screenshot.
 *
 * Varianten: 'web' (Layout-Komposition), 'it' (Ordnung aus Chaos),
 * 'brand' (Grundformen eines Erscheinungsbilds).
 */
interface Props {
  variant: 'web' | 'it' | 'brand';
}
const { variant } = Astro.props;

const deep = '#2A2260';
const accent = '#5B4FD1';
const tint = '#ECE9FB';
const paper = '#FAF8F4';
---

{variant === 'web' && (
  <svg viewBox="0 0 800 500" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="presentation">
    <!-- Wireframe-Komposition -->
    <rect x="110" y="80" width="430" height="330" rx="14" fill={paper} stroke={deep} stroke-width="2.5"/>
    <line x1="110" y1="136" x2="540" y2="136" stroke={deep} stroke-width="2.5"/>
    <rect x="136" y="102" width="46" height="10" rx="5" fill={deep}/>
    <rect x="424" y="102" width="34" height="10" rx="5" fill={deep} opacity="0.35"/>
    <rect x="470" y="102" width="34" height="10" rx="5" fill={accent}/>
    <rect x="140" y="166" width="180" height="100" rx="8" fill={accent}/>
    <rect x="348" y="178" width="150" height="10" rx="5" fill={deep}/>
    <rect x="348" y="200" width="110" height="10" rx="5" fill={deep} opacity="0.35"/>
    <rect x="348" y="230" width="88" height="28" rx="6" stroke={deep} stroke-width="2.5"/>
    <rect x="140" y="296" width="112" height="82" rx="8" fill={tint} stroke={deep} stroke-width="2.5"/>
    <rect x="268" y="296" width="112" height="82" rx="8" fill={tint} stroke={deep} stroke-width="2.5"/>
    <rect x="396" y="296" width="112" height="82" rx="8" fill={tint} stroke={deep} stroke-width="2.5"/>
    <!-- Versetzter Kreis (Offset-Print-Anmutung) -->
    <circle cx="610" cy="150" r="70" fill={accent}/>
    <circle cx="624" cy="164" r="70" stroke={deep} stroke-width="2.5"/>
    <rect x="590" y="330" width="56" height="56" rx="10" transform="rotate(12 618 358)" fill={deep}/>
    <path d="M84 434h24M96 422v24" stroke={deep} stroke-width="2.5" stroke-linecap="round"/>
    <path d="M688 62h24M700 50v24" stroke={deep} stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="712" cy="424" r="5" fill={accent}/>
    <circle cx="734" cy="424" r="5" fill={accent} opacity="0.45"/>
  </svg>
)}

{variant === 'it' && (
  <svg viewBox="0 0 800 500" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="presentation">
    <!-- Verstreute Elemente laufen in geordnete Struktur zusammen -->
    <line x1="140" y1="128" x2="368" y2="248" stroke={accent} stroke-width="2.5"/>
    <line x1="192" y1="258" x2="368" y2="252" stroke={accent} stroke-width="2.5"/>
    <line x1="134" y1="352" x2="368" y2="256" stroke={accent} stroke-width="2.5"/>
    <line x1="238" y1="416" x2="370" y2="260" stroke={accent} stroke-width="2.5"/>
    <line x1="378" y1="250" x2="500" y2="155" stroke={deep} stroke-width="2.5"/>
    <line x1="378" y1="252" x2="500" y2="250" stroke={deep} stroke-width="2.5"/>
    <line x1="378" y1="254" x2="500" y2="345" stroke={deep} stroke-width="2.5"/>
    <rect x="120" y="108" width="40" height="40" rx="7" transform="rotate(-9 140 128)" fill={tint} stroke={deep} stroke-width="2.5"/>
    <rect x="172" y="238" width="40" height="40" rx="7" transform="rotate(11 192 258)" fill={tint} stroke={deep} stroke-width="2.5"/>
    <rect x="114" y="332" width="40" height="40" rx="7" transform="rotate(5 134 352)" fill={tint} stroke={deep} stroke-width="2.5"/>
    <rect x="218" y="396" width="40" height="40" rx="7" transform="rotate(-13 238 416)" fill={tint} stroke={deep} stroke-width="2.5"/>
    <circle cx="372" cy="252" r="11" fill={deep}/>
    <circle cx="372" cy="252" r="20" stroke={accent} stroke-width="2.5" opacity="0.5"/>
    <rect x="500" y="123" width="190" height="64" rx="10" fill={accent}/>
    <rect x="500" y="218" width="190" height="64" rx="10" fill={tint} stroke={deep} stroke-width="2.5"/>
    <rect x="500" y="313" width="190" height="64" rx="10" fill={deep}/>
    <circle cx="500" cy="155" r="8" fill={paper} stroke={deep} stroke-width="2.5"/>
    <circle cx="500" cy="250" r="8" fill={paper} stroke={deep} stroke-width="2.5"/>
    <circle cx="500" cy="345" r="8" fill={paper} stroke={deep} stroke-width="2.5"/>
    <path d="M660 70h24M672 58v24" stroke={deep} stroke-width="2.5" stroke-linecap="round"/>
    <path d="M96 448h24M108 436v24" stroke={deep} stroke-width="2.5" stroke-linecap="round"/>
  </svg>
)}

{variant === 'brand' && (
  <svg viewBox="0 0 800 500" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="presentation">
    <!-- Grundformen als Bausteine eines Erscheinungsbilds -->
    <circle cx="300" cy="216" r="104" fill={accent}/>
    <rect x="330" y="188" width="168" height="168" rx="4" transform="rotate(-6 414 272)" stroke={deep} stroke-width="2.5"/>
    <path d="M544 356L622 218L700 356Z" fill={tint} stroke={deep} stroke-width="2.5" stroke-linejoin="round"/>
    <!-- Wiederholung = System -->
    <circle cx="146" cy="424" r="11" fill={accent}/>
    <rect x="182" y="413" width="22" height="22" rx="3" stroke={deep} stroke-width="2.5"/>
    <path d="M232 435l12.5-22l12.5 22Z" fill={tint} stroke={deep} stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="298" cy="424" r="11" fill={accent} opacity="0.4"/>
    <rect x="334" y="413" width="22" height="22" rx="3" stroke={deep} stroke-width="2.5" opacity="0.4"/>
    <path d="M384 435l12.5-22l12.5 22Z" stroke={deep} stroke-width="2.5" stroke-linejoin="round" opacity="0.4"/>
    <path d="M660 96h24M672 84v24" stroke={deep} stroke-width="2.5" stroke-linecap="round"/>
    <path d="M108 118h24M120 106v24" stroke={deep} stroke-width="2.5" stroke-linecap="round"/>
  </svg>
)}
