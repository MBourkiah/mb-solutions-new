<style>
  .cta {
    position: relative;
    background: var(--deep);
    color: var(--on-deep);
  }
  .cta-inner-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .cta-h2 {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800; letter-spacing: -0.03em;
    line-height: 1.0; margin: 0 0 1.25rem;
    color: var(--on-deep);
  }
  .cta-h2 .accent { color: var(--accent-deep); }
  .cta-sub {
    font-size: 1.0625rem; color: var(--on-deep-2); line-height: 1.7;
    max-width: 42ch; margin: 0;
  }

  .cta-actions { display: flex; flex-direction: column; gap: 1.5rem; }
  .cta-btns { display: flex; gap: 12px; flex-wrap: wrap; }

  .cta-direct {
    display: flex; flex-direction: column; gap: 8px;
    padding-top: 1.25rem;
    border-top: 1px solid var(--deep-line);
  }
  .cta-direct-label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--on-deep-3);
  }
  .cta-direct a {
    color: var(--on-deep); text-decoration: none;
    font-size: 1rem; font-weight: 500;
    transition: color 150ms var(--ease-out);
    width: fit-content;
  }
  @media (hover: hover) and (pointer: fine) {
    .cta-direct a:hover { color: var(--accent-deep); }
  }

  @media (max-width: 820px) {
    .cta-inner-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .cta-btns { flex-direction: column; }
    .cta-btns .btn-light { justify-content: center; }
  }
</style>

<section class="cta section-pad on-deep" aria-labelledby="cta-heading">
  <div class="container-site">
    <div class="cta-inner-grid">
      <div>
        <h2 class="cta-h2 reveal" id="cta-heading">
          Lass uns über dein Projekt <span class="accent">sprechen.</span>
        </h2>
        <p class="cta-sub reveal">
          Kostenloses Erstgespräch — kein Verkaufsdruck, keine Verpflichtung.
          Erzähl mir, was du brauchst, und du bekommst innerhalb von 48 Stunden
          eine ehrliche Einschätzung.
        </p>
      </div>

      <div class="cta-actions reveal">
        <div class="cta-btns">
          <a href="/kontakt" class="btn-light">Kostenloses Erstgespräch</a>
        </div>
        <div class="cta-direct">
          <span class="cta-direct-label">Oder direkt</span>
          <a href="tel:+491718165966">+49 171 816 59 66</a>
          <a href="mailto:mbourkiah@mb-solutions.biz">mbourkiah@mb-solutions.biz</a>
        </div>
      </div>
    </div>
  </div>
</section>
