---
/**
 * Ab-Preise: Richtwerte, final ist immer das Festpreisangebot
 * aus dem Erstgespräch. Zahlen hier zentral pflegen.
 */
const packages = [
  {
    name: 'Website',
    price: 'ab 790 €',
    desc: 'Der professionelle Auftritt für deinen Betrieb — von der Struktur bis zum Live-Gang.',
    features: [
      'Design & Umsetzung, mobil optimiert',
      'Texte gemeinsam geschärft',
      'Lokales SEO & Google-Grundlagen',
      'Impressum, Datenschutz, Cookie-frei wo möglich',
      'Launch inkl. Domain- und Hosting-Setup',
    ],
    featured: true,
  },
  {
    name: 'Branding',
    price: 'ab 690 €',
    desc: 'Logo, Farben, Schriften und Vorlagen — ein Erscheinungsbild, das überall gleich aussieht.',
    features: [
      'Logo in allen benötigten Formaten',
      'Farb- und Schriftsystem',
      'Visitenkarten- & Angebotsvorlagen',
      'Kurzes CI-Manual zum Weitergeben',
    ],
    featured: false,
  },
  {
    name: 'IT-Setup',
    price: 'ab 390 €',
    desc: 'E-Mail, Cloud und Geräte sauber eingerichtet — einmal ordentlich, statt ewig provisorisch.',
    features: [
      'Professionelle E-Mail mit eigener Domain',
      'Cloud-Speicher & automatische Backups',
      'Geräteeinrichtung im Betrieb',
      'Auf Wunsch: laufende Betreuung',
    ],
    featured: false,
  },
];
---

<style>
  .pricing { background: var(--paper); }
  .pricing-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 2rem; flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .pricing-h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.04; margin: 1.25rem 0 0;
    max-width: 15ch;
  }
  .pricing-sub {
    font-size: 1rem; color: var(--ink-2); line-height: 1.65;
    max-width: 38ch; margin: 0;
  }

  .pricing-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
    align-items: stretch;
  }

  .price-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex; flex-direction: column;
  }
  .price-card.featured { border-color: var(--accent); border-width: 1.5px; }

  .price-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 1rem; margin-bottom: 1rem;
  }
  .price-name {
    font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em;
    margin: 0; line-height: 1.2;
  }
  .price-tag {
    font-family: var(--font-mono); font-size: 15px; font-weight: 600;
    color: var(--accent-strong); white-space: nowrap;
    letter-spacing: -0.01em;
  }
  .price-desc {
    font-size: 0.9063rem; color: var(--ink-2); line-height: 1.65;
    margin: 0 0 1.5rem;
  }
  .price-features {
    list-style: none; margin: 0 0 1.75rem; padding: 1.25rem 0 0;
    border-top: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 9px; flex: 1;
  }
  .price-features li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 0.875rem; color: var(--ink-2); line-height: 1.5;
  }
  .price-features svg { color: var(--accent); flex-shrink: 0; margin-top: 4px; }

  .pricing-note {
    margin-top: 1.75rem;
    font-size: 0.875rem; color: var(--ink-2); line-height: 1.6;
    max-width: 64ch;
  }
  .pricing-note strong { color: var(--ink); font-weight: 600; }

  @media (max-width: 980px) { .pricing-grid { grid-template-columns: 1fr; } }
  @media (min-width: 640px) and (max-width: 980px) {
    .pricing-grid { grid-template-columns: repeat(2, 1fr); }
    .price-card:first-child { grid-column: span 2; }
  }
</style>

<section class="pricing section-pad" aria-labelledby="pricing-heading" id="preise">
  <div class="container-site">
    <div class="pricing-header">
      <div>
        <p class="label-mono reveal">Preise</p>
        <h2 class="pricing-h2 reveal" id="pricing-heading">
          Klare Richtwerte statt „kommt drauf an".
        </h2>
      </div>
      <p class="pricing-sub reveal">
        Jedes Projekt bekommt vor dem Start ein Festpreisangebot —
        diese Werte zeigen dir, wo es losgeht.
      </p>
    </div>

    <div class="pricing-grid">
      {packages.map(p => (
        <div class={`price-card reveal ${p.featured ? 'featured' : ''}`}>
          <div class="price-top">
            <h3 class="price-name">{p.name}</h3>
            <span class="price-tag">{p.price}</span>
          </div>
          <p class="price-desc">{p.desc}</p>
          <ul class="price-features">
            {p.features.map(f => (
              <li>
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <a href="/kontakt" class={p.featured ? 'btn-primary' : 'btn-ghost'} style="justify-content:center;">
            Erstgespräch anfragen
          </a>
        </div>
      ))}
    </div>

    <p class="pricing-note reveal">
      <strong>Wichtig:</strong> Das sind Einstiegswerte für überschaubare
      Projekte. Was dein Vorhaben konkret kostet, klären wir im kostenlosen
      Erstgespräch — danach bekommst du einen Festpreis, der gilt.
    </p>
  </div>
</section>
