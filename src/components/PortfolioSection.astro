---
import ProjectVisual from './ProjectVisual.astro';

const projects = [
  {
    title: 'Café Morgenrot',
    category: 'Webdesign — Gastronomie',
    visual: { real: 'cafe-morgenrot', variant: 'web' as const },
    visualAlt: 'Abstrakte Illustration einer Website-Struktur in Violett auf Papierweiß',
    problem: 'Reservierungen liefen ausschließlich über das Telefon — abends blieb der Anrufbeantworter voll.',
    solution: 'Website mit Online-Reservierung, Speisekarte und Google-Maps-Anbindung, in drei Wochen umgesetzt.',
  },
  {
    title: 'Keller & Söhne GmbH',
    category: 'IT-Setup + Branding — Handwerk',
    visual: { real: 'keller-soehne', variant: 'it' as const },
    visualAlt: 'Abstrakte Illustration: verstreute Elemente laufen in eine geordnete Struktur zusammen',
    problem: 'Angebote von drei verschiedenen Freemail-Adressen, kein einheitliches Erscheinungsbild.',
    solution: 'Google-Workspace-Migration, neues Logo und Vorlagen — ein Auftritt vom Briefkopf bis zur E-Mail-Signatur.',
  },
  {
    title: 'Yogastudio Sonnenlicht',
    category: 'Webdesign — Kurse & Buchung',
    visual: { real: 'yogastudio-sonnenlicht', variant: 'brand' as const },
    visualAlt: 'Abstrakte Illustration aus Grundformen: Kreis, Quadrat und Dreieck in Violett',
    problem: 'Kursbuchungen per DM und Zettelwirtschaft, keine Übersicht über freie Plätze.',
    solution: 'Ruhige, minimalistische Website mit Kurskalender und Online-Buchung, mobil zuerst gedacht.',
  },
];
---

<style>
  .work { background: var(--paper); }
  .work-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 2rem; flex-wrap: wrap;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .work-h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.04; margin: 0 0 0;
  }
  .work-note {
    font-size: 0.9375rem; color: var(--ink-2); line-height: 1.65;
    max-width: 40ch; margin: 0;
  }
  .work-note strong { color: var(--ink); font-weight: 600; }

  /* ── Aufmacher: erstes echtes Projekt ── */
  .work-featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: clamp(1.75rem, 3.5vw, 3rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .wf-badge {
    display: inline-block;
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: #fff; background: var(--accent);
    padding: 4px 10px; border-radius: var(--r-sm);
    margin-bottom: 14px;
  }
  .wf-title {
    font-size: clamp(1.5rem, 3vw, 2.125rem); font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.1; margin: 0 0 0.875rem;
  }
  .wf-text {
    font-size: 0.9688rem; color: var(--ink-2); line-height: 1.7;
    margin: 0 0 1.5rem; max-width: 44ch;
  }

  /* ── Konzeptprojekt-Zeilen ── */
  .work-list { display: flex; flex-direction: column; }

  .work-item {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(1.25rem, 3vw, 3rem);
    padding: clamp(1.75rem, 3.5vw, 2.5rem) 0;
    border-top: 1px solid var(--border);
    align-items: start;
  }
  .work-list .work-item:last-child { border-bottom: 1px solid var(--border); }

  .work-item-head { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .work-badge {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-strong); background: var(--tint);
    padding: 4px 10px; border-radius: var(--r-sm);
  }
  .work-title {
    font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.1; margin: 0;
  }
  .work-cat {
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3);
  }

  .work-fields { display: flex; flex-direction: column; gap: 1.125rem; }
  .work-field { display: grid; grid-template-columns: 118px 1fr; gap: 1rem; }
  .work-field-label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3);
    padding-top: 3px;
  }
  .work-field-text {
    font-size: 0.9688rem; color: var(--ink-2); line-height: 1.65; margin: 0;
  }

  .work-cta-row { margin-top: clamp(2rem, 4vw, 3rem); }

  @media (max-width: 980px) {
    .work-item { grid-template-columns: 160px minmax(0, 1fr); }
    .work-item .work-fields { grid-column: 2; }
  }
  @media (max-width: 820px) {
    .work-featured { grid-template-columns: 1fr; }
    .work-item { grid-template-columns: 1fr; gap: 1.25rem; }
    .work-item .work-fields { grid-column: auto; }
    .work-item-visual { max-width: 320px; }
    .work-field { grid-template-columns: 1fr; gap: 2px; }
  }
</style>

<section class="work section-pad" aria-labelledby="work-heading">
  <div class="container-site">
    <div class="work-header">
      <div>
        <h2 class="work-h2 reveal" id="work-heading">So gehe ich Projekte an.</h2>
      </div>
      <p class="work-note reveal">
        <strong>Offen gesagt:</strong> MB-Solutions ist frisch gestartet.
        Das erste echte Projekt ist diese Website — dazu Konzeptprojekte,
        die meine Arbeitsweise zeigen.
      </p>
    </div>

    <!-- Erstes echtes Projekt: diese Website -->
    <article class="work-featured reveal" aria-label="Echtes Projekt: diese Website">
      <div>
        <span class="wf-badge">Echtes Projekt</span>
        <h3 class="wf-title">Diese Website</h3>
        <p class="wf-text">
          Gebaut wie ein Kundenprojekt: eigenes Farbsystem, selbst gehostete
          Schriften, fast kein JavaScript — und ehrlich gekennzeichnete
          Inhalte statt erfundener Referenzen. Was du hier siehst, ist
          gleichzeitig meine Arbeitsprobe.
        </p>
        <a href="/portfolio" class="link-arrow">
          Zum Projekt-Steckbrief
          <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
            <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <ProjectVisual
        real="mb-solutions-website"
        variant="web"
        alt="Screenshot der Startseite von mb-solutions.biz"
        caption="Echter Screenshot · mb-solutions.biz"
      />
    </article>

    <div class="work-list">
      {projects.map(p => (
        <article class="work-item reveal">
          <div class="work-item-visual">
            <ProjectVisual
              real={p.visual.real}
              variant={p.visual.variant}
              alt={p.visualAlt}
              compact
            />
          </div>
          <div class="work-item-head">
            <span class="work-badge">Konzeptprojekt</span>
            <h3 class="work-title">{p.title}</h3>
            <span class="work-cat">{p.category}</span>
          </div>
          <div class="work-fields">
            <div class="work-field">
              <span class="work-field-label">Ausgangslage</span>
              <p class="work-field-text">{p.problem}</p>
            </div>
            <div class="work-field">
              <span class="work-field-label">Lösung</span>
              <p class="work-field-text">{p.solution}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="work-cta-row reveal">
      <a href="/portfolio" class="link-arrow">
        Alle Projekte im Detail
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2 7.5h11M9 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
