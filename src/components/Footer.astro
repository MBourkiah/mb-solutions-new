---
const footerLinks = [
  {
    heading: 'Seiten',
    links: [
      { label: 'Startseite',  href: '/' },
      { label: 'Leistungen',  href: '/leistungen' },
      { label: 'Arbeiten',    href: '/portfolio' },
      { label: 'Über mich',   href: '/ueber-mich' },
      { label: 'Kontakt',     href: '/kontakt' },
    ],
  },
  {
    heading: 'Leistungen',
    links: [
      { label: 'Webdesign',   href: '/leistungen#webdesign' },
      { label: 'IT-Services', href: '/leistungen#it-services' },
      { label: 'Branding',    href: '/leistungen#branding' },
    ],
  },
  {
    heading: 'Kontakt',
    links: [
      { label: '+49 171 816 59 66',           href: 'tel:+491718165966' },
      { label: 'mbourkiah@mb-solutions.biz',  href: 'mailto:mbourkiah@mb-solutions.biz' },
      { label: 'Köln, Deutschland',           href: '/kontakt' },
    ],
  },
];
---

<style>
  .footer {
    background: var(--deep-2);
    color: var(--on-deep-2);
    padding: clamp(3.5rem, 7vw, 5rem) 0 2.25rem;
    border-top: 1px solid var(--deep-line);
  }

  .footer-top {
    display: grid; grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 3rem; padding-bottom: 3rem;
    border-bottom: 1px solid var(--deep-line);
  }

  .footer-logo {
    display: inline-flex; align-items: baseline;
    text-decoration: none; margin-bottom: 1.125rem;
    font-family: var(--font-display);
    font-size: 19px; font-weight: 800;
    letter-spacing: -0.02em; line-height: 1;
    color: var(--on-deep);
  }
  .footer-logo .logo-dot { color: var(--accent-deep); }
  .footer-desc {
    font-size: 0.875rem; line-height: 1.7; max-width: 30ch;
    margin: 0;
  }

  .footer-col-heading {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--on-deep-3); margin-bottom: 1.125rem;
  }
  .footer-col-links { display: flex; flex-direction: column; gap: 10px; }
  .footer-col-link {
    font-size: 0.9063rem; color: var(--on-deep-2); text-decoration: none;
    transition: color 130ms var(--ease-out);
    overflow-wrap: anywhere;
    width: fit-content;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-col-link:hover { color: var(--on-deep); }
  }

  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 2rem; flex-wrap: wrap; gap: 1rem;
  }
  .footer-copy {
    font-family: var(--font-mono);
    font-size: 12px; color: var(--on-deep-3); margin: 0;
  }
  .footer-legal { display: flex; gap: 1.5rem; }
  .footer-legal a {
    font-size: 13px; color: var(--on-deep-3); text-decoration: none;
    transition: color 130ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-legal a:hover { color: var(--on-deep); }
  }

  @media (max-width: 860px) { .footer-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) {
    .footer-top { grid-template-columns: 1fr; gap: 2rem; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

<footer class="footer on-deep" aria-label="Footer">
  <div class="container-site">
    <div class="footer-top">
      <div>
        <a href="/" class="footer-logo" aria-label="MB-Solutions – Startseite">
          MB<span class="logo-dot">.</span>Solutions
        </a>
        <p class="footer-desc">
          Webdesign, IT-Services und Branding für Handwerksbetriebe
          und KMU in Köln. Persönlich. Direkt. Ohne Overhead.
        </p>
      </div>

      {footerLinks.map(col => (
        <div>
          <div class="footer-col-heading">{col.heading}</div>
          <nav class="footer-col-links" aria-label={col.heading}>
            {col.links.map(l => <a href={l.href} class="footer-col-link">{l.label}</a>)}
          </nav>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">© {new Date().getFullYear()} MB-Solutions, Köln</p>
      <div class="footer-legal">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
