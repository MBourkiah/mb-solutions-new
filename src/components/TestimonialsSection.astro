---
/**
 * Kundenstimmen — Platzhalter-Struktur.
 *
 * Solange das Array leer ist, wird die Section NICHT gerendert.
 * Sobald echte Stimmen da sind, einfach eintragen:
 *
 * const testimonials = [
 *   {
 *     quote: 'Wörtliches Zitat des Kunden — konkret, nicht generisch.',
 *     name: 'Vor- und Nachname',
 *     role: 'Funktion, Firma',
 *     project: 'Webdesign',            // optional: Art des Projekts
 *   },
 * ];
 */
const testimonials: {
  quote: string;
  name: string;
  role: string;
  project?: string;
}[] = [];
---

<style>
  .testi { background: var(--paper-dim); }
  .testi-header { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .testi-h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.04; margin: 0 0 0;
  }

  .testi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }
  .testi-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: 2rem;
    display: flex; flex-direction: column; gap: 1.5rem;
  }
  .testi-quote {
    font-size: 1.0625rem; color: var(--ink); line-height: 1.65;
    margin: 0; font-weight: 450;
  }
  .testi-meta { margin-top: auto; display: flex; flex-direction: column; gap: 2px; }
  .testi-name {
    font-family: var(--font-display); font-size: 15px; font-weight: 600;
    color: var(--ink); letter-spacing: -0.01em;
  }
  .testi-role { font-size: 13px; color: var(--ink-2); }
  .testi-project {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);
    margin-top: 8px;
  }
</style>

{testimonials.length > 0 && (
  <section class="testi section-pad" aria-labelledby="testi-heading">
    <div class="container-site">
      <div class="testi-header">
        <h2 class="testi-h2 reveal" id="testi-heading">Das sagen Kunden.</h2>
      </div>
      <div class="testi-grid">
        {testimonials.map(t => (
          <figure class="testi-card reveal">
            <blockquote class="testi-quote">„{t.quote}"</blockquote>
            <figcaption class="testi-meta">
              <span class="testi-name">{t.name}</span>
              <span class="testi-role">{t.role}</span>
              {t.project && <span class="testi-project">{t.project}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
