---
/**
 * Bildfläche eines Projekts mit Auto-Swap:
 *
 * - Liegt unter `src/assets/real/<real>.{jpg,jpeg,png,webp}` eine echte
 *   Datei, wird sie optimiert (AVIF/WebP + Fallback) und lazy ausgeliefert.
 * - Fehlt sie, erscheint die Konzept-Illustration im Corporate Design —
 *   klar beschriftet, damit nichts wie ein vorgetäuschter Screenshot wirkt.
 *
 * Zum Austauschen später: Datei mit passendem Namen in src/assets/real/
 * legen — kein Code-Änderung nötig. Siehe src/assets/real/README.md.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectIllustration from './illustrations/ProjectIllustration.astro';

interface Props {
  /** Dateiname (ohne Endung) in src/assets/real/ */
  real?: string;
  variant: 'web' | 'it' | 'brand';
  alt: string;
  /** Beschriftung unter dem Bild; bei compact entfällt sie */
  caption?: string;
  compact?: boolean;
}

const { real, variant, alt, caption, compact = false } = Astro.props;

const realImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/real/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const match = real
  ? Object.entries(realImages).find(([path]) =>
      path.replace(/\.[a-z]+$/, '').endsWith(`/${real}`),
    )?.[1].default
  : undefined;

const fallbackCaption = match ? undefined : 'Konzept-Illustration';
const shownCaption = compact ? undefined : (caption ?? fallbackCaption);
---

<style>
  .pv {
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface);
  }
  .pv-frame {
    aspect-ratio: 8 / 5;
    display: block;
    background: var(--tint);
  }
  .pv-frame.is-real { background: var(--paper-dim); }
  .pv-frame :global(img),
  .pv-frame :global(picture) {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: top center;
  }
  .pv-frame :global(svg) {
    display: block; width: 100%; height: 100%;
  }
  .pv-caption {
    display: flex; align-items: center; gap: 8px;
    padding: 9px 14px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-3);
    background: var(--surface);
  }
  .pv-caption::before {
    content: '';
    width: 7px; height: 7px; flex-shrink: 0;
    border: 1.5px solid var(--accent);
  }
</style>

<figure class="pv">
  <div class={`pv-frame ${match ? 'is-real' : ''}`}>
    {match ? (
      <Picture
        src={match}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(max-width: 820px) 92vw, 700px"
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <ProjectIllustration variant={variant} />
    )}
  </div>
  {shownCaption && <figcaption class="pv-caption">{shownCaption}</figcaption>}
</figure>
