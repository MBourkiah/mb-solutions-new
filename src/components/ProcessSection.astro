---
const steps = [
  {
    num: '01',
    title: 'Kostenloses Erstgespräch',
    desc: 'Wir besprechen dein Projekt, deine Ziele und dein Budget — kein Verkaufsdruck, keine Verpflichtung. Einfach ein offenes Gespräch.',
    benefits: [
      'Telefonisch oder per Video-Call',
      'Kostenfrei, 30–45 Minuten',
      'Direktes Feedback zu deinen Ideen',
    ],
  },
  {
    num: '02',
    title: 'Konzept & Umsetzung',
    desc: 'Du erhältst ein klares Festpreisangebot. Nach deiner Freigabe starte ich — mit regelmäßigem Feedback und kurzen Abstimmungswegen.',
    benefits: [
      'Transparenter Festpreis, keine Stundensätze',
      'Fertigstellung in 2–6 Wochen',
      'Jederzeit Einblick in den aktuellen Stand',
    ],
  },
  {
    num: '03',
    title: 'Live & dauerhafter Support',
    desc: 'Dein Auftritt geht online. Ich begleite dich auch danach — bei Updates, Erweiterungen und allen technischen Fragen bin ich direkt erreichbar.',
    benefits: [
      'Launch inkl. technischem Setup',
      'Direkter Kontakt auch nach Go-Live',
      'Kein Ticketsystem, kein Supportcenter',
    ],
  },
];
---

<style>
  .process {
    background: var(--deep);
    color: var(--on-deep);
  }

  .process-header { margin-bottom: clamp(3rem, 6vw, 5rem); max-width: 40rem; }
  .process-h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.04; margin: 1.25rem 0 1.25rem;
    color: var(--on-deep);
  }
  .process-sub {
    font-size: 1.0625rem; color: var(--on-deep-2); line-height: 1.7; margin: 0;
  }

  /* ── Steps mit durchgezogener Linie ── */
  .process-steps { position: relative; }

  /* Schiene (Hintergrund der Linie) */
  .process-steps::before {
    content: '';
    position: absolute; top: 12px; bottom: 12px; left: 23px;
    width: 2px; background: var(--deep-line);
  }
  /* Die Linie, die sich beim Scrollen füllt */
  .process-line {
    position: absolute; top: 12px; bottom: 12px; left: 23px;
    width: 2px; background: var(--accent-deep);
    transform-origin: top center;
    transform: scaleY(0);
    will-change: transform;
  }

  .p-step {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .p-step:last-child { padding-bottom: 0; }

  .p-node {
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--deep);
    border: 2px solid var(--deep-line);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 13px; font-weight: 500;
    color: var(--on-deep-3);
    position: relative; z-index: 1;
    transition: border-color 400ms var(--ease-out), color 400ms var(--ease-out),
                background 400ms var(--ease-out);
  }
  .p-step.lit .p-node {
    border-color: var(--accent-deep);
    color: var(--deep);
    background: var(--accent-deep);
  }

  .p-body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding-top: 8px;
  }
  .p-title {
    font-size: clamp(1.375rem, 2.5vw, 1.75rem); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.12;
    margin: 0 0 0.75rem; color: var(--on-deep);
  }
  .p-desc { font-size: 1rem; color: var(--on-deep-2); line-height: 1.7; margin: 0; }

  .p-benefits {
    list-style: none; padding: 0; margin: 4px 0 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .p-benefits li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 0.875rem; color: var(--on-deep-2); line-height: 1.55;
  }
  .p-benefits svg { color: var(--accent-deep); flex-shrink: 0; margin-top: 4px; }

  @media (max-width: 820px) {
    .p-body { grid-template-columns: 1fr; gap: 1.25rem; }
    .process-steps::before, .process-line { left: 19px; }
    .p-node { width: 40px; height: 40px; font-size: 12px; }
    .p-step { grid-template-columns: 40px minmax(0, 1fr); }
  }
</style>

<section class="process section-pad on-deep" aria-labelledby="process-heading" id="prozess">
  <div class="container-site">
    <div class="process-header">
      <p class="label-mono reveal">Ablauf</p>
      <h2 class="process-h2 reveal" id="process-heading">
        Eine Linie — vom ersten Gespräch bis zum Launch.
      </h2>
      <p class="process-sub reveal">
        Kein Staffellauf zwischen Abteilungen: Dein Projekt läuft in drei
        Schritten durch — bei einer Person, ohne Übergaben.
      </p>
    </div>

    <div class="process-steps" id="process-steps">
      <div class="process-line" id="process-line" aria-hidden="true"></div>
      {steps.map(s => (
        <div class="p-step" data-step>
          <div class="p-node" aria-hidden="true">{s.num}</div>
          <div class="p-body">
            <div>
              <h3 class="p-title">{s.title}</h3>
              <p class="p-desc">{s.desc}</p>
            </div>
            <ul class="p-benefits">
              {s.benefits.map(b => (
                <li>
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const container = document.getElementById('process-steps');
  const line = document.getElementById('process-line');
  const stepEls = Array.from(document.querySelectorAll('[data-step]'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (container && line) {
    if (reduced) {
      line.style.transform = 'scaleY(1)';
      stepEls.forEach(el => el.classList.add('lit'));
    } else {
      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = container.getBoundingClientRect();
        const anchor = window.innerHeight * 0.6;
        const progress = Math.min(1, Math.max(0, (anchor - rect.top) / rect.height));
        line.style.transform = `scaleY(${progress})`;
        const lineEnd = rect.top + rect.height * progress;
        stepEls.forEach(el => {
          const nodeTop = el.getBoundingClientRect().top + 12;
          el.classList.toggle('lit', nodeTop <= lineEnd);
        });
      };
      const onScroll = () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
